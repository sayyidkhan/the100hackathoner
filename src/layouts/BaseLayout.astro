---
import "../styles/global.css";
import "../styles/pages.css";
import ThemeHead from "../components/ThemeHead.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The 100 Hackathoner",
  description = "A public record of Sayyid Khan's journey to complete 100 hackathons by building, shipping, failing, winning, and learning in public.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <ThemeHead />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="site-pages">
    <slot />
  </body>
</html>
