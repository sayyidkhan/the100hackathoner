    grid-column: 1 / -1;
    max-width: none;
    margin-top: 34px;
    padding-top: 16px;
    border-top: 1px solid rgba(218, 234, 240, 0.28);
  }

  .hero-progress-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(218, 234, 240, 0.6);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-progress-topline strong {
    color: #f5f7f7;
  }

  .meter {
    margin-top: 12px;
    height: 14px;
    border: 1px solid rgba(218, 234, 240, 0.26);
    background: rgba(218, 234, 240, 0.11);
