---
import Header from "../components/Header.astro";
import SeoHead from "../components/SeoHead.astro";
import { Image, getImage } from "astro:assets";
import workbenchLight from "../../public/landing/assets/hackathon-workbench.png";
import workbenchDark from "../../public/landing/assets/hackathon-workbench-dark-v1.png";
import stageImage from "../../public/landing/assets/hackathon-stage.png";
import bookLight from "../../public/landing/assets/storybook-concept-v3.jpg";
import bookDark from "../../public/landing/assets/storybook-dark-v1.jpg";
import crowLight from "../../public/landing/assets/crow-concept-v3.jpg";
import crowDark from "../../public/landing/assets/crow-dark-v1.jpg";
import borneoLight from "../../public/landing/assets/borneo-concept-v3.jpg";
import borneoDark from "../../public/landing/assets/borneo-dark-v1.jpg";
import ThemeHead from "../components/ThemeHead.astro";
import { getHackathons } from "../lib/hackathons";
import { buildTotals } from "../lib/insights";
const projects = [...getHackathons()].sort((a, b) => b.number - a.number);
const journeyTotals = buildTotals(projects);
const latest = projects[0];
const awards = projects.filter(project => project.award).length;
const byNumber = new Map(projects.map(project => [project.number, project]));
const artworks = [
  { number: 81, light: bookLight, dark: bookDark, alt: "Concept artwork: a red open book with a folded-paper landscape, house, and cobalt path" },
  { number: 80, light: crowLight, dark: crowDark, alt: "Concept artwork: a black origami crow flying above a miniature ivory city" },
  { number: 79, light: borneoLight, dark: borneoDark, alt: "Concept artwork: a timber longhouse surrounded by folded-paper forest and a cobalt river" },
];
async function responsive(src: typeof bookLight, widths: number[]) {
  const images = await Promise.all(widths.map(width => getImage({ src, width, format: "webp", quality: 78 })));
  return { src: images.at(-1)!.src, srcset: images.map((image, index) => `${image.src} ${widths[index]}w`).join(", ") };
}
const artImages = await Promise.all(artworks.map(async art => ({ ...art, lightImage: await responsive(art.light, [480, 768, 1200, 1536]), darkImage: await responsive(art.dark, [480, 768, 1200, 1536]) })));
const benchLight = await responsive(workbenchLight, [400, 720, 1100]);
const benchDark = await responsive(workbenchDark, [400, 720, 1100]);
---
<!doctype html>
<html lang="en" data-view="artwork" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <ThemeHead />
    <SeoHead title="The 100 Hackathoner" description="Sayyid Khan's living record of the ideas, teams, wrong turns, and breakthroughs on the way from engineer to founder." />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='32' fill='%23e51b23'/%3E%3Ctext x='32' y='40' text-anchor='middle' font-family='Arial' font-weight='bold' font-size='25' fill='white'%3E100%3C/text%3E%3C/svg%3E"
    />

    <link rel="stylesheet" href="/landing/styles.css" />
  </head>
  <body>
    <a class="skip" href="#collection">Skip to collection</a>
    <Header />
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-intro wrap">
          <div>
            <p class="eyebrow">A LIFE IN PROTOTYPES / SINCE 2016</p>
            <h1 id="hero-title">
              THE <span>100</span><br />HACKATHONER<span>.</span>
            </h1>
            <p class="hero-tagline">
              One hundred hackathons.<br />A <em>thousand ways</em> to become someone new.
            </p>
          </div>
          <div class="hero-note">
            <p>
              I’m Sayyid Khan. A builder becoming a founder,
              one hackathon at a time.
            </p>
            <a href="#collection">Explore the collection <span>↘</span></a>
          </div>
        </div>

        <div class="gallery-top wrap">
          <p class="gallery-kicker">
            <span class="live-mark" aria-hidden="true"></span> SELECTED ATTEMPTS
          </p>
          <div
            class="view-switch"
            role="group"
            aria-label="Exhibit display mode"
          >
            <button
              type="button"
              id="artwork-mode"
              data-view-mode="artwork"
              aria-pressed="true"
            >
              <span aria-hidden="true">▧</span> Artwork
            </button>
            <button
              type="button"
              id="three-mode"
              data-view-mode="3d"
              aria-pressed="false"
            >
              <span aria-hidden="true">◇</span> Explore in 3D
            </button>
          </div>
        </div>

        <div
          class="gallery"
          id="gallery"
          role="region"
          aria-label="Selected hackathon exhibits"
        >
          <div
            id="artwork-stage"
            class="artwork-stage"
            role="region"
            aria-roledescription="carousel"
            aria-label="Featured concept artworks"
          >
            {artImages.map((art, index) => (
              <button class={`art-object ${index === 0 ? "is-active" : index === 1 ? "is-after" : "is-before"}`} data-object={art.number} aria-label={`${index === 0 ? "Open" : "Select"} ${byNumber.get(art.number)?.title}`} tabindex={index === 0 ? 0 : -1}>
                <picture class="theme-picture">
                  <source data-dark-source media="(prefers-color-scheme: dark)" srcset={art.darkImage.srcset} sizes="(max-width: 700px) 100vw, 70vw" type="image/webp" />
                  <img class="theme-art" src={art.lightImage.src} srcset={art.lightImage.srcset} sizes="(max-width: 700px) 100vw, 70vw" width={art.light.width} height={art.light.height} alt={art.alt} draggable="false" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} decoding="async" />
                </picture>
              </button>
            ))}
          </div>
          <div id="three-stage" class="three-stage" hidden>
            <canvas
              id="gallery-canvas"
              tabindex="0"
              aria-label="Interactive 3D concept object. Drag or use arrow keys to rotate."
            ></canvas>
            <div class="scene-tools">
              <button type="button" id="reset-view">Reset view ↺</button
              ><button type="button" id="pause-motion" aria-pressed="false">
                Pause motion
              </button>
            </div>
          </div>
          <div class="gallery-edge edge-left" aria-hidden="true">
            IDEAS BECOME OBJECTS.<br />ATTEMPTS BECOME STORIES.
          </div>
          <div class="gallery-edge edge-right" aria-hidden="true">
            <span id="stage-number">081</span><br />ON DISPLAY
          </div>
          <button
            type="button"
            id="previous-exhibit"
            class="gallery-arrow prev"
            aria-label="Previous exhibit"
          >
            ←
          </button>
          <button
            type="button"
            id="next-exhibit"
            class="gallery-arrow next"
            aria-label="Next exhibit"
          >
            →
          </button>
          <p class="gallery-hint" id="gallery-hint">
            DRAG TO EXPLORE · SELECT TO OPEN
          </p>
        </div>
        <p
          class="mode-status wrap"
          id="mode-status"
          role="status"
          aria-live="polite"
        ></p>

        <div class="exhibit-caption wrap">
          <div class="caption-copy" aria-live="polite">
            <p class="eyebrow" id="featured-event">081 / ANTI-DRUG JAM 2026</p>
            <h2 id="featured-title">The Next 8 Seconds</h2>
            <p id="featured-description">
              An illustrated adventure through peer pressure. Sketch a solution.
              Find your way home.
            </p>
          </div>
          <button class="primary-button" id="open-story" type="button">
            Open the story <span>↗</span>
          </button>
        </div>

        <div
          class="exhibit-selector wrap"
          role="group"
          aria-label="Choose a featured attempt"
        >
          <button type="button" data-exhibit="81" aria-pressed="true">
            <span class="exhibit-number">081</span
            ><span>The Next 8 Seconds<small>SOCIAL GOOD / 2026</small></span
            ><span class="select-mark" aria-hidden="true">↗</span>
          </button>
          <button type="button" data-exhibit="80" aria-pressed="false">
            <span class="exhibit-number">080</span
            ><span>Itachi’s Crow<small>GENERATIVE AI / 2026</small></span
            ><span class="select-mark" aria-hidden="true">↗</span>
          </button>
          <button type="button" data-exhibit="79" aria-pressed="false">
            <span class="exhibit-number">079</span
            ><span>Long Taa Borneo<small>CULTURE × AI / 2026</small></span
            ><span class="select-mark" aria-hidden="true">↗</span>
          </button>
        </div>
      </section>

      <section class="story-section wrap section" id="story">
        <div>
          <p class="eyebrow">NOT A TROPHY ROOM.</p>
          <div class="journey-count">
            <strong id="journey-count">{projects.length}</strong
            ><span>/ 100<br />HACKATHONS</span>
          </div>
          <picture class="theme-picture">
            <source data-dark-source media="(prefers-color-scheme: dark)" srcset={benchDark.srcset} sizes="(max-width: 800px) 100vw, 45vw" type="image/webp" />
            <img class="section-picture workbench-light adaptive-workbench" src={benchLight.src} srcset={benchLight.srcset} sizes="(max-width: 800px) 100vw, 45vw" alt="Concept illustration: a paper-sculpted laptop, notebook and prototypes on a hackathon workbench" loading="lazy" decoding="async" width={workbenchLight.width} height={workbenchLight.height} />
          </picture>
        </div>
        <div class="story-copy">
          <h2>A record of<br /><span>showing up.</span></h2>
          <p>
            I’m Sayyid. I use hackathons to test ideas, meet people, and turn
            uncertainty into something real. Each attempt is part of the change
            from engineer to founder.
          </p>
          <dl class="story-snapshot" aria-label="The journey in numbers">
            <div><dt>Solo runs</dt><dd>{journeyTotals.soloBuilds}</dd></div>
            <div><dt>Team builds</dt><dd>{journeyTotals.teamBuilds}</dd></div>
            <div><dt>Collaborators</dt><dd>{journeyTotals.collaborators}</dd></div>
          </dl>
          <div class="story-loop">
            <p class="eyebrow">THE PRACTICE BEHIND THE NUMBER</p>
            <ol aria-label="My building process">
              <li><span>01</span> Test an idea</li>
              <li><span>02</span> Build something real</li>
              <li><span>03</span> Learn. Go again.</li>
            </ol>
          </div>
          <a class="text-link" href="/about/"
            >The person behind the projects ↗</a
          >
        </div>
      </section>

      <section class="collection wrap section" id="collection">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / THE PUBLIC RECORD</p>
            <h2>Pick an attempt.<br /><span>Find a story.</span></h2>
          </div>
          <div>
            <p>Every one belongs here.<br />Not only the wins.</p>
            <button class="text-button" id="surprise" type="button">
              Surprise me ↗
            </button>
          </div>
        </div>
        <div class="collection-controls">
          <div class="filters" role="group" aria-label="Collection filter">
            <button data-filter="all" aria-pressed="true">
              All attempts <span id="all-count">{projects.length}</span></button
            ><button data-filter="awarded" aria-pressed="false">
              Awarded <span id="award-count">{awards}</span>
            </button>
          </div>
          <label class="search"
            ><span class="sr-only">Search the collection</span
            ><input
              type="search"
              id="search"
              placeholder="Search a project, theme, year…"
          /></label>
        </div>
        <div class="archive-toolbar">
          <div class="archive-view" role="group" aria-label="Collection layout">
            <button type="button" data-collection-view="grid" aria-pressed="true">Grid</button>
            <button type="button" data-collection-view="list" aria-pressed="false">List</button>
          </div>
        </div>
        <p id="result-status" class="result-status" role="status">{projects.length} recorded attempts · {Math.max(0, 100 - projects.length)} still to come</p>
        <div id="grid-collection" class="grid-collection">
          <div class="attempt-wall">
            <div class="grid-legend" aria-label="Attempt legend">
              <span><i class="legend-done"></i>Completed</span>
              <span><i class="legend-award"></i>Awarded</span>
              <span><i class="legend-current"></i>Current</span>
              <span><i class="legend-ahead"></i>Ahead</span>
            </div>
            <div id="attempt-grid" class="attempt-grid" role="group" aria-label="Journey to 100 hackathons">
              {Array.from({ length: Math.max(100, latest?.number ?? 0) }, (_, index) => index + 1).map(number => {
                const project = byNumber.get(number);
                return project ? <a class:list={["attempt-tile", { "is-awarded": Boolean(project.award), "is-current": number === latest?.number }]} href={`/hackathons/${number}/?from=landing`} aria-label={`Attempt ${number}: ${project.title}`}>{String(number).padStart(2, "0")}</a> : <span class="attempt-tile is-ahead" aria-label={`Attempt ${number}: still ahead`}>{String(number).padStart(2, "0")}</span>;
              })}
            </div>
            <p class="grid-help">100 places in the collection. An unfinished story.</p>
          </div>
          <aside class="attempt-preview" aria-labelledby="preview-title">
            <div class="preview-top"><span class="eyebrow">FROM THE COLLECTION</span><span id="preview-state">CURRENT</span></div>
            <div id="preview-number" class="preview-number" aria-hidden="true">{String(latest?.number ?? 0).padStart(3, "0")}</div>
            <p id="preview-date" class="eyebrow">{latest?.dateLabel} / {latest?.country}</p>
            <h3 id="preview-title">{latest?.title}</h3>
            <p id="preview-description">{latest?.solution}</p>
            <p id="preview-award" hidden></p>
            <a id="preview-open" class="text-button" href={`/hackathons/${latest?.number}/?from=landing`}>Open the story <span aria-hidden="true">↗</span></a>
          </aside>
        </div>
        <div class="collection-year-controls">
          <div id="collection-years" class="collection-years" role="group" aria-label="Filter attempts by year"></div>
        </div>
        <div id="project-list" class="project-list" hidden></div>
        <button type="button" class="secondary-button" id="load-more" hidden>
          More from the collection ↓
        </button>
      </section>

      <section class="book-section wrap section">
        <div class="section-visual">
          <p class="eyebrow">02 / BEYOND THE NUMBER</p>
          <figure class="memoir-book">
            <div class="memoir-stage">
            <div class="memoir-pages" aria-hidden="true">
              <span class="page-kicker">FROM THE FIELD / 001</span>
              <span class="page-heading">Keep<br />showing up.</span>
              <div class="page-notes">
                <span class="written-note note-one">Start with an idea.</span>
                <span class="written-note note-two">Build something real.</span>
                <span class="written-note note-three">Learn. Then go again.</span>
                <svg class="book-underline" viewBox="0 0 260 24" fill="none" aria-hidden="true"><path pathLength="1" d="M3 15Q118 3 253 12" /></svg>
              </div>
              <span class="page-footnote">A LIFE IN PROTOTYPES</span>
              <span class="page-number">01</span>
            </div>
            <div class="memoir-cover memoir-original" aria-label="Concept cover for The 100 Hackathoner by Sayyid Khan">
              <span class="memoir-kicker">THE 100 HACKATHONER</span>
              <strong class="memoir-mark">100</strong>
              <span class="memoir-author">SAYYID KHAN</span>
            </div>
            <div class="memoir-cover memoir-forward" aria-label="Concept cover for The Forward Deployed Hackathoner by Sayyid Khan">
              <span class="memoir-kicker">THE FORWARD DEPLOYED<br />HACKATHONER</span>
              <strong class="memoir-mark" aria-hidden="true">↗</strong>
              <span class="memoir-author">SAYYID KHAN</span>
            </div>
            </div>
            <figcaption>FUTURE BOOKS · COVER CONCEPTS</figcaption>
          </figure>
        </div>
        <div>
          <h2>A hundred hackathons.<br /><span>More stories to tell.</span></h2>
          <p>
            The projects, the people, the failures, the turning points. The 100
            Hackathoner is my living memoir of how building things changes the
            person doing the building.
          </p>
          <a class="primary-button" href="/waitlist/">Join the book waitlist <span aria-hidden="true">↗</span></a>
          <fieldset class="book-titles">
            <legend>ON THE HORIZON / WORKING TITLES</legend>
            <label>
              <input type="radio" name="book-title" value="memoir" checked />
              <span><small>01 / THE MEMOIR</small>The 100 Hackathoner</span>
              <span class="book-choice-arrow" aria-hidden="true">↗</span>
            </label>
            <label>
              <input type="radio" name="book-title" value="forward" />
              <span><small>02 / THE NEXT CHAPTER</small>The Forward Deployed Hackathoner</span>
              <span class="book-choice-arrow" aria-hidden="true">↗</span>
            </label>
          </fieldset>
        </div>
      </section>
      <section class="invitation wrap section">
        <p class="eyebrow">03 / LET’S TAKE IT OUT OF THE BROWSER</p>
        <div class="invitation-grid">
          <div class="invitation-copy">
            <h2>From the build.<br /><span>To the room.</span></h2>
            <p>
              Lessons from the road to 100 hackathons.<br />Building under pressure. AI in practice.<br />Turning experiments into opportunities.
            </p>
            <nav class="invitation-links" aria-label="Speaking and judging">
              <a href="/about/#contact"><span><small>01 / SPEAKING & CONVERSATIONS</small>Invite me to your next event</span><span aria-hidden="true">↗</span></a>
              <a href="/workshops/"><span><small>02 / PRACTICAL AI WORKSHOP</small>Build an AI prototype with your team</span><span aria-hidden="true">↗</span></a>
              <a href="/judging/"><span><small>03 / JUDGING & FEEDBACK</small>Meet me at the judging table</span><span aria-hidden="true">↗</span></a>
            </nav>
          </div>
          <figure class="invitation-art">
            <Image src={stageImage} widths={[400, 720, 1100]} sizes="(max-width: 800px) 100vw, 45vw" format="webp" quality={78} alt="Concept illustration: a red microphone on an ivory paper stage surrounded by folded audience seats" width="1280" height="1280" loading="lazy" />
            <figcaption>IDEAS WORTH TAKING INTO THE ROOM.</figcaption>
          </figure>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <a href="#">THE 100 HACKATHONER ↗</a
      ><span>A living collection.</span
      ><span>SAYYID KHAN / SINGAPORE</span>
      <span class="footer-copyright">All rights reserved. <span id="copyright-year">{new Date().getFullYear()}</span></span>
    </footer>
    <dialog id="project-dialog" aria-labelledby="dialog-title">
      <button
        id="close-dialog"
        type="button"
        aria-label="Close project details"
      >
        ×
      </button>
      <p class="eyebrow" id="dialog-number"></p>
      <h2 id="dialog-title"></h2>
      <p id="dialog-event"></p>
      <p id="dialog-solution"></p>
      <div id="dialog-tags"></div>
      <p id="dialog-award"></p>
      <a
        class="primary-button"
        id="dialog-link"
        >View hackathon details ↗</a
      >
    </dialog>
    <noscript
      ><p class="wrap">
        Enable JavaScript to change exhibits and explore the interactive
        collection.
        <a href="/hackathons/">Browse all hackathons.</a>
      </p></noscript
    >
    <script is:inline id="collection-data" type="application/json" set:html={JSON.stringify(projects).replace(/</g, "\\u003c")} />
    <script is:inline>
      (() => {
        const updatePictures = () => {
          document.querySelectorAll('[data-dark-source]').forEach(source => {
            source.media = document.documentElement.dataset.theme === 'dark' ? 'all' : 'not all';
          });
        };
        updatePictures();
        document.addEventListener('site:theme-change', updatePictures);
      })();
    </script>
    <script is:inline src="/landing/app.js" type="module"></script>
    <script>
      const copyrightYear = document.querySelector('#copyright-year');
      if (copyrightYear) copyrightYear.textContent = String(new Date().getFullYear());
      const book = document.querySelector('.memoir-book');
      const motionAllowed = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const artObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          entry.target.classList.toggle('is-art-visible', entry.isIntersecting);
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('.workbench-light, .workbench-dark, .invitation-art img')
        .forEach(image => artObserver.observe(image));
      if (book && motionAllowed) {
        const observer = new IntersectionObserver(([entry]) => {
          book.classList.toggle('is-visible', entry.isIntersecting);
          if (entry.isIntersecting) book.classList.add('is-playing');
        }, { threshold: 0.35 });
        observer.observe(book);
      }
      document.querySelectorAll('input[name="book-title"]').forEach(input => {
        input.addEventListener('change', () => {
          book?.classList.remove('is-playing');
          void book?.getBoundingClientRect();
          if (motionAllowed) book?.classList.add('is-playing');
        });
      });
    </script>
  </body>
</html>

<style>
  .theme-picture { display: contents; }
  :global([data-theme="dark"]) .adaptive-workbench { display: block !important; }
  :global([data-theme="dark"]) .theme-art { mix-blend-mode: normal; mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent), linear-gradient(to bottom, transparent, #000 3%, #000 97%, transparent); mask-composite: intersect; }
  .attempt-tile { text-decoration: none; }
</style>
