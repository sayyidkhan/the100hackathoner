  }

  .map-legend .award {
    background: #05776e;
  }

  .map-legend .current {
    background: var(--red);
  }

  .map-legend .milestone {
    background: var(--yellow);
  }

  .map-legend .future {
    border: 1px solid var(--line-strong);
    background: white;
  }

  .map-summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px 0;
