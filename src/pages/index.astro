    min-width: 0;
  }

  .checkpoint-grid {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 6px;
    width: min(100%, 680px);
    padding: 20px 0 26px;
  }

  .map-year-tabs {
    display: grid;
    gap: 5px;
    padding: 20px 0 26px;
  }

  .year-tabs-label {
    margin: 0 0 3px;
    color: var(--faint);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

