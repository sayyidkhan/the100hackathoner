---
import { getCollection } from "astro:content";
import HeroCinematicBackdrop from "../components/HeroCinematicBackdrop.astro";
import PageShell from "../components/PageShell.astro";
import { getHackathons } from "../lib/hackathons";

const hackathons = getHackathons();
const essays = (await getCollection("essays")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const completed = hackathons[0]?.number ?? 0;
const total = 100;
const remaining = total - completed;
const featured = hackathons[0];
const progressPercent = Math.round((completed / total) * 100);

const checkpoints = Array.from({ length: total }, (_, index) => {
  const number = index + 1;
  const known = hackathons.find((item) => item.number === number);
  return {
    number,
    title: known?.title ?? "",
    event: known?.event ?? "",
    dateLabel: known?.dateLabel ?? "",
    solution: known?.solution ?? "",
    tags: known?.tags.slice(0, 2) ?? [],
    award: known?.award ?? "",
    status:
      number < completed
        ? "complete"
        : number === completed
          ? "current"
          : number % 10 === 0
            ? "milestone"
            : "future",
  };
});

const lessonPatterns = [
  {
    title: "Ship the smallest complete loop",
    body: "The demo only matters when someone can touch the core behavior without a long explanation.",
    accent: "red",
  },
  {
    title: "Judgement beats more tools",
    body: "Agent products need boundaries, handoffs, and restraint before they need another integration.",
    accent: "blue",
  },
  {
    title: "Clarity is a safety feature",
    body: "In serious domains, simple flows and visible next steps earn trust before action.",
    accent: "teal",
  },
  {
    title: "Volume turns lessons into instinct",
    body: "Repeated deadlines convert abstract advice into pattern recognition under pressure.",
    accent: "yellow",
  },
];

---

<PageShell
  title="The 100 Hackathoner"
  description="A public record of Sayyid Khan's journey to complete 100 hackathons by building, shipping, failing, winning, and learning in public."
>
  <section class="hero">
    <HeroCinematicBackdrop />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1><span>The 100</span><span>Hackathoner</span></h1>
        <p class="mission">
          A public record of learning by shipping: ideas, teams, chaos, demos,
          failures, wins, and the operating lessons behind one hundred
          hackathons.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/hackathons/">Explore the Journey</a>
          <a class="button" href="/essays/">Read Field Notes</a>
        </div>
        <div class="hero-progress" aria-label={`${completed} of ${total} hackathons completed`}>
          <div class="hero-progress-topline">
            <span>Journey to 100</span>
            <strong>{completed} / {total}</strong>
          </div>
          <div class="meter" aria-hidden="true">
            <span style={`width: ${progressPercent}%`}></span>
          </div>
          <div class="hero-progress-meta">
            <span>{progressPercent}% complete</span>
            <span>Current: #{String(completed).padStart(3, "0")}</span>
            <span>{remaining} remaining</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="journey-map section" id="journey">
    <div class="container">
      <div class="section-heading">
        <h2 class="serif">Journey Map</h2>
        <p>
          One hundred numbered attempts. Each checkpoint records what was built,
          what broke, who showed up, and what became sharper after demo day.
        </p>
      </div>

      <div class="map-panel">
        <div class="map-legend">
          <span><i class="complete"></i> Completed</span>
          <span><i class="current"></i> Current</span>
          <span><i class="milestone"></i> Milestone</span>
          <span><i class="future"></i> Ahead</span>
        </div>
        <div class="checkpoint-grid" aria-label="One hundred hackathon checkpoints">
          {
            checkpoints.map((checkpoint) => (
              <a
                class={`checkpoint ${checkpoint.status}`}
                href={
                  checkpoint.title
                    ? `/hackathons/${checkpoint.number}/`
                    : "/hackathons/"
                }
                aria-label={
                  checkpoint.title
                    ? `Hackathon ${checkpoint.number}: ${checkpoint.title}. View details.`
                    : `Hackathon ${checkpoint.number}`
                }
              >
                {String(checkpoint.number).padStart(2, "0")}
                {
                  checkpoint.title && (
                    <span class="checkpoint-preview" role="tooltip">
                      <span class="preview-kicker">
                        #{String(checkpoint.number).padStart(3, "0")}
                        {checkpoint.dateLabel && ` · ${checkpoint.dateLabel}`}
                      </span>
                      <strong>{checkpoint.title}</strong>
                      <span class="preview-event">{checkpoint.event}</span>
                      {checkpoint.solution && <span class="preview-solution">{checkpoint.solution}</span>}
                      <span class="preview-footer">
                        {checkpoint.tags.length > 0 && checkpoint.tags.join(" · ")}
                        {checkpoint.award && <em>{checkpoint.award}</em>}
                      </span>
                    </span>
                  )
                }
              </a>
            ))
          }
        </div>
        <div class="map-note">
          <strong>Current checkpoint</strong>
          <span>
            #{String(completed).padStart(3, "0")} {featured?.title}
          </span>
        </div>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="field-report section">
        <div class="container report-grid">
          <div class="report-visual" aria-hidden="true">
            <div class="game-card">
              <div class="game-header">
                <span>{featured.tags[0] ?? "Hackathon"}</span>
                <strong>#{String(featured.number).padStart(3, "0")}</strong>
              </div>
              <div class="game-grid">
                {Array.from({ length: 56 }, (_, index) => (
                  <span class={index % 9 === 0 ? "hot" : index % 7 === 0 ? "cool" : ""} />
                ))}
              </div>
              <div class="game-footer">
                <span>Deploy</span>
                <span>Demo</span>
                <span>Learn</span>
              </div>
            </div>
          </div>
          <div class="report-copy">
            <p class="meta">Latest Field Report</p>
            <h2 class="serif">
              #{String(featured.number).padStart(3, "0")} {featured.title}
            </h2>
            <p class="lesson">{featured.solution ?? "Project details not recorded."}</p>
            <p>
              The latest chapter captures the useful pressure of every
              hackathon: what can be made real, understandable, and demo-ready
              before time runs out?
            </p>
            <div class="stack-row" aria-label={`${featured.title} themes`}>
              {featured.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <a class="button blue" href={`/hackathons/${featured.number}/`}>View the Record</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="lessons section">
    <div class="container">
      <div class="section-heading">
        <h2 class="serif">Lessons That Compound</h2>
        <p>
          The point is not to collect trophies. The point is to turn repeated
          deadlines into sharper product judgement, stronger taste, and better
          founder instincts.
        </p>
      </div>
      <div class="lesson-grid">
        {
          lessonPatterns.map((lesson, index) => (
            <article class={`lesson-card ${lesson.accent}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{lesson.title}</h3>
              <p>{lesson.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="notes section">
    <div class="container">
      <div class="section-heading">
        <h2 class="serif">Field Notes</h2>
        <p>
          Memoir notes on identity, ambition, AI-assisted creation, failure,
          and the kind of work worth repeating.
        </p>
      </div>
      <div class="notes-list">
        {
          essays.slice(0, 3).map((essay) => (
            <a class="note-row" href={`/essays/${essay.slug}/`}>
              <time datetime={essay.data.date}>{essay.data.date}</time>
              <strong>{essay.data.title}</strong>
              <span>{essay.data.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="builder-band section">
    <div class="container builder-grid">
      <div>
        <p class="meta">About the Builder</p>
        <h2 class="serif">Builder. Operator in progress.</h2>
      </div>
      <div>
        <p>
          Sayyid Khan is a Singapore-based AI builder and software engineer
          using hackathons to test ideas, sharpen execution, explore business
          opportunities, and document the journey from builder mindset to
          founder/operator mindset.
        </p>
        <ul>
          <li>AI agents</li>
          <li>SaaS</li>
          <li>Automation</li>
          <li>Developer tooling</li>
          <li>Sustainability</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="invite-band">
    <div class="container invite-grid">
      <div>
        <h2>Invite me to speak, judge, mentor, or build.</h2>
        <p>
          Workshops, hackathon judging, founder conversations, AI prototyping,
          and sessions for builders learning through execution.
        </p>
      </div>
      <a class="button primary" href="/contact/">Start a Conversation</a>
    </div>
  </section>
</PageShell>

<style>
  .hero {
    --hero-height: clamp(720px, 78vh, 900px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: var(--hero-height);
    border-bottom: 1px solid rgba(218, 234, 240, 0.18);
    padding: 86px 0 78px;
    background: #05070b;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: calc(var(--hero-height) - 164px);
    align-items: center;
    max-width: none;
  }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.8fr);
    column-gap: clamp(36px, 6vw, 120px);
    align-items: end;
  }

  h1 {
    grid-row: span 2;
    max-width: 900px;
    margin: 0;
    color: #f5f7f7;
    font-size: clamp(3.8rem, 6.4vw, 6.4rem);
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 0.82;
    text-shadow: 0 8px 45px rgba(0, 0, 0, 0.45);
  }

  h1 span {
    display: block;
  }

  .mission {
    max-width: 560px;
    margin: 0;
    color: rgba(225, 236, 239, 0.76);
    font-size: clamp(1.06rem, 1.8vw, 1.3rem);
    line-height: 1.65;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.52);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-actions .button:not(.primary) {
    border-color: rgba(232, 241, 243, 0.64);
    background: rgba(5, 7, 11, 0.34);
    color: #f5f7f7;
    backdrop-filter: blur(8px);
  }

  .hero-actions .button:not(.primary):hover {
    border-color: #f5f7f7;
    background: #f5f7f7;
    color: #05070b;
  }

  .hero-progress {
    grid-column: 1 / -1;
    max-width: none;
    margin-top: 34px;
    padding-top: 16px;
    border-top: 1px solid rgba(218, 234, 240, 0.28);
  }

  .hero-progress-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(218, 234, 240, 0.6);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-progress-topline strong {
    color: #f5f7f7;
  }

  .meter {
    margin-top: 12px;
    height: 14px;
    border: 1px solid rgba(218, 234, 240, 0.26);
    background: rgba(218, 234, 240, 0.11);
    box-shadow: 0 0 32px rgba(19, 88, 219, 0.11);
  }

  .meter span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--red), var(--blue), var(--teal));
    box-shadow: 0 0 18px rgba(19, 88, 219, 0.34);
    transform-origin: left center;
  }

  .hero-progress-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 12px;
    color: rgba(218, 234, 240, 0.48);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .journey-map {
    background: var(--bg-paper);
  }

  .map-panel {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .map-legend span {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  .map-legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .map-legend .complete {
    background: var(--teal);
  }

  .map-legend .current {
    background: var(--red);
  }

  .map-legend .milestone {
    background: var(--yellow);
  }

  .map-legend .future {
    border: 1px solid var(--line-strong);
    background: white;
  }

  .checkpoint-grid {
    display: grid;
    grid-template-columns: repeat(20, minmax(0, 1fr));
    gap: 0;
    padding: 22px;
  }

  .checkpoint {
    --preview-opacity: 0;
    --preview-offset: 8px;
    display: grid;
    min-height: 48px;
    place-items: center;
    position: relative;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 900;
    transition:
      background 140ms ease,
      color 140ms ease,
      transform 140ms ease;
  }

  .checkpoint:hover,
  .checkpoint:focus-visible {
    --preview-opacity: 1;
    --preview-offset: 0;
    z-index: 2;
    transform: scale(1.08);
  }

  .checkpoint:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .checkpoint-preview {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    z-index: 4;
    display: none;
    width: min(272px, calc(100vw - 40px));
    gap: 6px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: var(--black);
    box-shadow: 0 15px 32px rgba(5, 5, 5, 0.28);
    color: white;
    opacity: var(--preview-opacity);
    pointer-events: none;
    text-align: left;
    transform: translate(-50%, var(--preview-offset));
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .checkpoint:hover .checkpoint-preview,
  .checkpoint:focus-visible .checkpoint-preview {
    display: grid;
  }

  .preview-kicker {
    color: var(--yellow);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .checkpoint-preview strong {
    color: white;
    font-size: 1rem;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .preview-event,
  .preview-solution {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .preview-solution {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .preview-footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 7px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    color: #7ee2d7;
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .preview-footer em {
    color: #ffd66c;
    font-style: normal;
  }

  .checkpoint.complete {
    border-color: rgba(7, 155, 145, 0.5);
    background: rgba(7, 155, 145, 0.18);
    color: #05635d;
  }

  .checkpoint.current {
    background: var(--red);
    color: white;
  }

  .checkpoint.milestone {
    background: rgba(245, 181, 27, 0.22);
    color: #8a5f00;
  }

  .map-note {
    display: flex;
    gap: 18px;
    justify-content: space-between;
    padding: 18px 20px;
    border-top: 1px solid var(--line);
    background: var(--black);
    color: white;
  }

  .map-note strong {
    color: var(--yellow);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .field-report {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .report-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(340px, 0.72fr);
    gap: 52px;
    align-items: center;
  }

  .report-visual {
    padding: 20px;
    border: 1px solid var(--line-strong);
    background: var(--black);
  }

  .game-card {
    min-height: 420px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      #06130f;
    background-size: 38px 38px;
    color: white;
  }

  .game-header,
  .game-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    color: var(--yellow);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 8px;
    padding: 18px;
  }

  .game-grid span {
    min-height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
  }

  .game-grid .hot {
    background: rgba(237, 28, 36, 0.78);
  }

  .game-grid .cool {
    background: rgba(7, 155, 145, 0.82);
  }

  .report-copy h2 {
    margin: 12px 0 0;
    color: var(--ink);
    font-size: clamp(3rem, 6vw, 6.6rem);
    line-height: 0.88;
  }

  .report-copy p {
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.75;
  }

  .report-copy .lesson {
    color: var(--ink);
    font-size: 1.35rem;
    font-weight: 850;
    line-height: 1.35;
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 26px 0;
  }

  .stack-row span {
    border-top: 2px solid var(--line-strong);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 900;
    padding-top: 8px;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .lesson-card {
    min-height: 250px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 22px;
  }

  .lesson-card span {
    font-size: 0.82rem;
    font-weight: 950;
  }

  .lesson-card h3 {
    margin: 54px 0 12px;
    color: var(--ink);
    font-size: clamp(1.28rem, 2vw, 1.9rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .lesson-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .lesson-card.red {
    border-top: 5px solid var(--red);
  }

  .lesson-card.blue {
    border-top: 5px solid var(--blue);
  }

  .lesson-card.teal {
    border-top: 5px solid var(--teal);
  }

  .lesson-card.yellow {
    border-top: 5px solid var(--yellow);
  }

  .status {
    display: inline-flex;
    width: fit-content;
    padding: 6px 9px;
    background: rgba(31, 157, 85, 0.12);
    color: #116437;
    font-size: 0.74rem;
    font-weight: 900;
  }

  .notes-list {
    border-top: 1px solid var(--line-strong);
  }

  .note-row {
    display: grid;
    grid-template-columns: 150px minmax(220px, 0.75fr) minmax(260px, 1fr);
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .note-row time {
    color: var(--faint);
    font-size: 0.8rem;
    font-weight: 850;
  }

  .note-row strong {
    color: var(--ink);
    font-size: 1.28rem;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .note-row span {
    color: var(--muted);
    line-height: 1.6;
  }

  .builder-band {
    background: var(--surface-warm);
  }

  .builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(320px, 0.8fr);
    gap: 54px;
    align-items: start;
  }

  .builder-grid h2 {
    max-width: 560px;
    margin: 12px 0 0;
    color: var(--ink);
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.88;
  }

  .builder-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .builder-grid ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .builder-grid li {
    padding: 9px 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .invite-band {
    padding: 44px 0;
    background: var(--black);
    color: white;
  }

  .invite-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
  }

  .invite-grid h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2rem, 4vw, 4.8rem);
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .invite-grid p {
    max-width: 680px;
    margin: 14px 0 0;
