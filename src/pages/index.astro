---
import HeroCinematicBackdrop from "../components/HeroCinematicBackdrop.astro";
import PageShell from "../components/PageShell.astro";
import { getYear } from "../lib/format";
import { getHackathons } from "../lib/hackathons";

const hackathons = getHackathons();
const completed = hackathons[0]?.number ?? 0;
const total = 100;
const remaining = total - completed;
const featured = hackathons[0];
const progressPercent = Math.round((completed / total) * 100);
const years = [...new Set(hackathons.map((item) => getYear(item.startDate, item.dateLabel)).filter((year): year is number => year !== null))]
  .sort((a, b) => b - a)
  .map((year) => ({
    value: year,
    count: hackathons.filter((item) => getYear(item.startDate, item.dateLabel) === year).length,
  }));

function toIsoDate(date: Date) {
  return date.toISOString().slice(0, 10);
}

function formatCalendarDate(isoDate: string) {
  return new Intl.DateTimeFormat("en-SG", {
    weekday: "short",
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${isoDate}T00:00:00Z`));
}

const quarterNames = ["Jan – Mar", "Apr – Jun", "Jul – Sep", "Oct – Dec"];

function calendarQuartersForYear(year: number) {
  const eventsByDate = new Map<string, typeof hackathons>();

  for (const event of hackathons) {
    if (getYear(event.startDate, event.dateLabel) !== year || !event.startDate) continue;
    const events = eventsByDate.get(event.startDate) ?? [];
    events.push(event);
    eventsByDate.set(event.startDate, events);
  }

  return quarterNames.map((label, quarter) => {
    const firstMonth = quarter * 3;
    const start = new Date(Date.UTC(year, firstMonth, 1));
    start.setUTCDate(start.getUTCDate() - start.getUTCDay());
    const end = new Date(Date.UTC(year, firstMonth + 3, 0));
    end.setUTCDate(end.getUTCDate() + (6 - end.getUTCDay()));
    const cells = [];

    for (let date = new Date(start); date <= end; date.setUTCDate(date.getUTCDate() + 1)) {
      const isoDate = toIsoDate(date);
      cells.push({
        isoDate,
        isInQuarter:
          date.getUTCFullYear() === year &&
          date.getUTCMonth() >= firstMonth &&
          date.getUTCMonth() < firstMonth + 3,
        events: eventsByDate.get(isoDate) ?? [],
      });
    }

    return { label, cells, weeks: cells.length / 7 };
  });
}

const calendarYears = years.map(({ value, count }) => ({
  year: value,
  count,
  quarters: calendarQuartersForYear(value),
}));

const checkpoints = Array.from({ length: total }, (_, index) => {
  const number = index + 1;
  const known = hackathons.find((item) => item.number === number);
  return {
    number,
    title: known?.title ?? "",
    event: known?.event ?? "",
    dateLabel: known?.dateLabel ?? "",
    solution: known?.solution ?? "",
    tags: known?.tags.slice(0, 2) ?? [],
    award: known?.award ?? "",
    year: known ? getYear(known.startDate, known.dateLabel) : null,
    status:
      number === completed
          ? "current"
        : known?.award
          ? "award"
          : number < completed
            ? "complete"
          : number % 10 === 0
            ? "milestone"
            : "future",
  };
});

---

<PageShell
  title="The 100 Hackathoner"
  description="A public record of Sayyid Khan's journey to complete 100 hackathons by building, shipping, failing, winning, and learning in public."
>
  <section class="hero">
    <HeroCinematicBackdrop />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1><span>The 100</span><span>Hackathoner</span></h1>
        <p class="mission">
          A public record of learning by shipping: ideas, teams, chaos, demos,
          failures, wins, and the operating lessons behind one hundred
          hackathons.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/hackathons/">Explore the Journey</a>
          <a class="button" href="/essays/">Read Field Notes</a>
        </div>
        <div class="hero-progress" aria-label={`${completed} of ${total} hackathons completed`}>
          <div class="hero-progress-topline">
            <span>Journey to 100</span>
            <strong>{completed} / {total}</strong>
          </div>
          <div class="meter" aria-hidden="true">
            <span style={`width: ${progressPercent}%`}></span>
          </div>
          <div class="hero-progress-meta">
            <span>{progressPercent}% complete</span>
            <span>Current: #{String(completed).padStart(3, "0")}</span>
            <span>{remaining} remaining</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="journey-map section" id="journey">
    <div class="container">
      <div class="section-heading">
        <h2 class="serif">Journey Map</h2>
        <p>
          One hundred numbered attempts. Each checkpoint records what was built,
          what broke, who showed up, and what became sharper after demo day.
        </p>
      </div>

      <div class="map-panel" data-map-view="sequence">
        <div class="map-legend">
          <span><i class="complete"></i> Completed</span>
          <span><i class="award"></i> Awarded</span>
          <span><i class="current"></i> Current</span>
          <span><i class="milestone"></i> Milestone</span>
          <span><i class="future"></i> Ahead</span>
        </div>
        <div class="map-summary">
          <div class="map-summary-copy">
            <span>Hackathons done</span>
            <strong>{completed} / {total}</strong>
            <span>{remaining} to go</span>
          </div>
          <div class="map-view-toggle" aria-label="Choose map view">
            <button type="button" class="active" aria-pressed="true" data-map-view-button="sequence">Sequence</button>
            <button type="button" aria-pressed="false" data-map-view-button="calendar">Calendar</button>
          </div>
        </div>
        <div class="map-content">
          <div class="map-display">
            <div class="checkpoint-grid" aria-label="One hundred hackathon checkpoints" data-sequence-view>
            {
              checkpoints.map((checkpoint) => (
                <a
                  class={`checkpoint ${checkpoint.status}`}
                  data-checkpoint-year={checkpoint.year ?? ""}
                  href={
                    checkpoint.title
                      ? `/hackathons/${checkpoint.number}/`
                      : "/hackathons/"
                  }
                  aria-label={
                    checkpoint.title
                      ? `Hackathon ${checkpoint.number}: ${checkpoint.title}. View details.`
                      : `Hackathon ${checkpoint.number}`
                  }
                >
                  {String(checkpoint.number).padStart(2, "0")}
                  {
                    checkpoint.title && (
                      <span class="checkpoint-preview" role="tooltip">
                        <span class="preview-kicker">
                          #{String(checkpoint.number).padStart(3, "0")}
                          {checkpoint.dateLabel && ` · ${checkpoint.dateLabel}`}
                        </span>
                        <strong>{checkpoint.title}</strong>
                        <span class="preview-event">{checkpoint.event}</span>
                        {checkpoint.solution && <span class="preview-solution">{checkpoint.solution}</span>}
                        <span class="preview-footer">
                          {checkpoint.tags.length > 0 && checkpoint.tags.join(" · ")}
                          {checkpoint.award && <em>{checkpoint.award}</em>}
                        </span>
                      </span>
                    )
                  }
                </a>
              ))
            }
            </div>
            <div class="calendar-views" data-calendar-view>
              {
                calendarYears.map(({ year, count, quarters }) => (
                  <section class="calendar-year" data-calendar-year={year} aria-label={`${year} hackathon calendar`}>
                    <header>
                      <strong>{year}</strong>
                      <span>{count} hackathons</span>
                    </header>
                    <div class="calendar-quarters">
                      {
                        quarters.map(({ label, cells, weeks }) => (
                          <section class="calendar-quarter" aria-label={`${label} ${year}`}>
                            <h3>{label}</h3>
                            <div class="calendar-frame">
                              <div class="calendar-weekdays" aria-hidden="true">
                                <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
                              </div>
                              <div class="calendar-grid" style={`--week-count: ${weeks}`}>
                        {
                          cells.map((cell, index) => {
                            const hasAward = cell.events.some((event) => Boolean(event.award));
                            const isCurrent = cell.events.some((event) => event.number === completed);
                            const intensity = Math.min(cell.events.length, 3);
                            const primary = cell.events[0];
                            const calendarDate = formatCalendarDate(cell.isoDate);
                            const weekdayIndex = index % 7;
                            const weekIndex = Math.floor(index / 7);
                            const previewVertical = weekdayIndex < 5 ? "preview-below" : "preview-above";
                            const previewHorizontal = weekIndex < 3
                              ? "preview-left"
                              : weekIndex > weeks - 4
                                ? "preview-right"
                                : "preview-center";

                            return cell.isInQuarter ? (
                              <a
                                class:list={[
                                  "calendar-day",
                                  cell.events.length > 0 && "has-event",
                                  hasAward && "award",
                                  isCurrent && "current",
                                  `intensity-${intensity}`,
                                  previewVertical,
                                  previewHorizontal,
                                ]}
                                href={primary ? `/hackathons/${primary.number}/` : undefined}
                                tabindex={primary ? undefined : 0}
                                aria-label={
                                  primary
                                    ? `Hackathon ${primary.number}: ${primary.title}. View details.`
                                    : `${calendarDate}. No hackathons recorded.`
                                }
                              >
                                {cell.events.length > 1 && <span>{cell.events.length}</span>}
                                <span class:list={["calendar-preview", !primary && "empty"]} role="tooltip">
                                  {
                                    primary ? (
                                      <>
                                      <span class="calendar-preview-kicker">
                                        #{String(primary.number).padStart(3, "0")}
                                        {primary.dateLabel && ` · ${primary.dateLabel}`}
                                      </span>
                                      <strong>{primary.title}</strong>
                                      <span class="calendar-preview-event">{primary.event}</span>
                                      <span class="calendar-preview-footer">
                                        {primary.award || primary.tags.slice(0, 2).join(" · ")}
                                        {cell.events.length > 1 && <em>+{cell.events.length - 1} more</em>}
                                      </span>
                                      </>
                                    ) : (
                                      <>
                                        <span class="calendar-preview-kicker">{calendarDate}</span>
                                        <strong>No hackathons</strong>
                                        <span class="calendar-preview-event">No contribution recorded for this date.</span>
                                      </>
                                    )
                                  }
                                </span>
                              </a>
                            ) : <span class="calendar-day outside" aria-hidden="true"></span>;
                          })
                        }
                              </div>
                            </div>
                          </section>
                        ))
                      }
                    </div>
                  </section>
                ))
              }
            </div>
          </div>
          <div class="map-year-tabs" aria-label="Filter hackathons by year" data-year-tabs>
            <span class="year-tabs-label">View</span>
            <button type="button" class="active" aria-pressed="true" data-year-filter="all">
              <span>All</span><b>{completed}</b>
            </button>
            {
              years.map(({ value, count }) => (
                <button type="button" aria-pressed="false" data-year-filter={value}>
                  <span>{value}</span><b>{count}</b>
                </button>
              ))
            }
          </div>
        </div>
        <div class="map-note">
          <strong>Current checkpoint</strong>
          <span>
            #{String(completed).padStart(3, "0")} {featured?.title}
          </span>
        </div>
      </div>
    </div>
  </section>

</PageShell>

<script>
  document.querySelectorAll<HTMLElement>("[data-map-view]").forEach((panel) => {
    const tabs = panel.querySelector<HTMLElement>("[data-year-tabs]");
    if (!tabs) return;

    const cells = [...panel.querySelectorAll<HTMLElement>("[data-sequence-view] [data-checkpoint-year]")];
    const calendarYears = [...panel.querySelectorAll<HTMLElement>("[data-calendar-year]")];
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>("[data-year-filter]")];
    const viewButtons = [...panel.querySelectorAll<HTMLButtonElement>("[data-map-view-button]")];

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedYear = button.dataset.yearFilter ?? "all";

        buttons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });

        cells.forEach((cell) => {
          const isMatch = selectedYear === "all" || cell.dataset.checkpointYear === selectedYear;
          cell.classList.toggle("is-filtered", !isMatch);
          cell.tabIndex = isMatch ? 0 : -1;
        });

        calendarYears.forEach((calendarYear) => {
          const isMatch = selectedYear === "all" || calendarYear.dataset.calendarYear === selectedYear;
          calendarYear.classList.toggle("is-filtered", !isMatch);
        });
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const view = button.dataset.mapViewButton ?? "sequence";
        panel.dataset.mapView = view;

        viewButtons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });
      });
    });
  });
</script>

<style>
  .hero {
    --hero-height: clamp(720px, 78vh, 900px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: var(--hero-height);
    border-bottom: 1px solid rgba(218, 234, 240, 0.18);
    padding: 86px 0 78px;
    background: #05070b;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: calc(var(--hero-height) - 164px);
    align-items: center;
    max-width: none;
  }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.8fr);
    column-gap: clamp(36px, 6vw, 120px);
    align-items: end;
  }

  h1 {
    grid-row: span 2;
    max-width: 900px;
    margin: 0;
    color: #f5f7f7;
    font-size: clamp(3.8rem, 6.4vw, 6.4rem);
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 0.82;
    text-shadow: 0 8px 45px rgba(0, 0, 0, 0.45);
  }

  h1 span {
    display: block;
  }

  .mission {
    max-width: 560px;
    margin: 0;
    color: rgba(225, 236, 239, 0.76);
    font-size: clamp(1.06rem, 1.8vw, 1.3rem);
    line-height: 1.65;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.52);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-actions .button:not(.primary) {
    border-color: rgba(232, 241, 243, 0.64);
    background: rgba(5, 7, 11, 0.34);
