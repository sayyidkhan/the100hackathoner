---
import PageShell from "../components/PageShell.astro";
import {
  buildPrizeSummary,
  buildPrizeTotals,
  formatPrizeAmount,
  getPrizeRecords,
  type PrizeCategory,
} from "../lib/prizes";
import { buildConvertedPrizeTotals, fxSource, getUsedFxMonths } from "../lib/fx";

const records = getPrizeRecords();
const summary = buildPrizeSummary(records);
const totals = buildPrizeTotals(records);
const converted = buildConvertedPrizeTotals(records);
const currencies = (["SGD", "USD"] as const).map((currency) => ({
  currency,
  original: totals.find((total) => total.currency === currency) ?? { team: 0, individual: 0 },
  equivalent: converted.totals[currency],
}));
const fxMonths = getUsedFxMonths(records);
const monthLabel = (month: string) => new Intl.DateTimeFormat("en-SG", { month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(`${month}-01T00:00:00Z`));
const formatFigure = (value: number) => new Intl.NumberFormat("en-SG", {
  minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
  maximumFractionDigits: 2,
}).format(value);
const prizeCategories: PrizeCategory[] = ["Cash & vouchers", "Credits", "Subscriptions", "Funding"];
const categoryByCurrency = (["SGD", "USD"] as const).map((currency) => ({
  currency,
  rows: prizeCategories.map((category) => ({
    category,
    amount: summary.find((row) => row.currency === currency && row.category === category),
  })),
}));
---

<PageShell
  title="Prize Money & Awards | The 100 Hackathoner"
  description="A public breakdown of hackathon prize money, credits, subscriptions, and funding, shown as team totals and individual share."
>
  <main class="container awards-page">
    <section class="intro">
      <p class="meta">Prize Money & Awards</p>
      <h1>What the builds earned.</h1>
      <p class="lead">
        Prize money, credits, subscriptions, and funding—shown as team totals
        and my share.
      </p>
    </section>

    <section class="fx-section" aria-labelledby="fx-heading">
      <div class="overview-heading">
        <p class="meta">At a glance</p>
        <h2 id="fx-heading">Prize totals</h2>
        <div class="overview-controls">
          <p>Awards in their original currency, split between the team and my share.</p>
          <button class="conversion-toggle" type="button" aria-expanded="false">
            <span class="conversion-icon" aria-hidden="true">↔</span>
            <span class="conversion-label">Show FX conversion</span>
          </button>
        </div>
      </div>
      <div class="currency-grid">
        {currencies.map(({ currency, original, equivalent }) => (
          <article class="currency-card">
            <div class="currency-card-head">
              <h3>{currency}</h3>
              <span>All amounts in {currency === "SGD" ? "S$" : "US$"}</span>
            </div>
            <div class="currency-original">
              <p>Awarded in {currency}</p>
              <dl>
                <div><dt>Team total</dt><dd>{formatFigure(original.team)}</dd></div>
                <div><dt>My share</dt><dd>{formatFigure(original.individual)}</dd></div>
              </dl>
            </div>
            <div class="currency-combined" hidden>
              <p>Converted total</p>
              <dl>
                <div><dt>Team total</dt><dd>{formatFigure(equivalent.team)}</dd></div>
                <div><dt>My share</dt><dd>{formatFigure(equivalent.individual)}</dd></div>
              </dl>
            </div>
          </article>
        ))}
      </div>
      {converted.pending.length > 0 && (
        <details class="pending-note" hidden>
          <summary>{converted.pending.length} awards not yet converted—the rates for their months aren’t out yet <span>See which</span></summary>
          <p>They are still included in the original-currency totals above.</p>
          <ul>{converted.pending.map((record) => <li>#{record.hackathon.number} · {record.category} · {record.hackathon.startDate ? monthLabel(record.hackathon.startDate.slice(0, 7)) : "Date unknown"}</li>)}</ul>
        </details>
      )}
      <dialog class="fx-dialog" id="fx-rate-dialog" aria-labelledby="fx-dialog-heading">
        <div class="fx-dialog-head">
          <div>
            <p class="meta">Exchange-rate record</p>
            <h3 id="fx-dialog-heading">Monthly FX rates</h3>
          </div>
          <button class="fx-close" type="button" aria-label="Close monthly FX rates">×</button>
        </div>
        <p>Federal Reserve G.5 monthly average, via <a href={fxSource} target="_blank" rel="noopener noreferrer">FRED EXSIUS</a>. USD→SGD is stored; SGD→USD is its reciprocal. Published months are cached.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Hackathon month</th><th>US$1 in SGD</th><th>S$1 in USD</th><th>Status</th></tr></thead>
            <tbody>
              {fxMonths.map(({ month, sgdPerUsd }) => (
                <tr>
                  <td>{monthLabel(month)}</td>
                  <td>{sgdPerUsd === undefined ? "—" : `S$${sgdPerUsd.toFixed(4)}`}</td>
                  <td>{sgdPerUsd === undefined ? "—" : `US$${(1 / sgdPerUsd).toFixed(4)}`}</td>
                  <td>{sgdPerUsd === undefined ? "Pending publication" : "Cached"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </dialog>
    </section>

    <section class="breakdown" aria-labelledby="breakdown-heading">
      <div class="section-title">
        <div>
          <p class="meta">By category</p>
          <h2 id="breakdown-heading">The breakdown</h2>
        </div>
        <p>Cash vouchers are counted as cash-equivalent. Credits, subscriptions, and funding remain separate categories.</p>
      </div>

      <div class="category-currency-grid">
        {categoryByCurrency.map(({ currency, rows }) => (
          <article class="category-currency-card">
            <div class="category-currency-head"><h3>{currency}</h3><span>Amounts in {currency === "SGD" ? "S$" : "US$"}</span></div>
            <div class="category-column-head"><span>Category</span><span>Team</span><span>My share</span></div>
            {rows.map(({ category, amount }) => (
              <div class="category-amount-row">
                <strong>{category}</strong>
                <span>{amount ? formatFigure(amount.team) : "—"}</span>
                <span>{amount ? formatFigure(amount.individual) : "—"}</span>
              </div>
            ))}
          </article>
        ))}
      </div>
      <p class="category-key">— No recorded value in that currency.</p>
    </section>

    <section class="records" aria-labelledby="records-heading">
      <div class="section-title">
        <div>
          <p class="meta">Prize details</p>
          <h2 id="records-heading">Where it came from</h2>
        </div>
        <p>{records.length} tracked prize entries across the journey.</p>
      </div>

      <div class="record-list">
        {
          records.map(({ hackathon, category, amount }) => (
            <article class="record">
              <div class="record-number">#{String(hackathon.number).padStart(3, "0")}</div>
              <div class="record-copy">
                <p class="record-category">{category} · {amount.currency}</p>
                <h3><a href={`/hackathons/${hackathon.number}/`}>{hackathon.title}</a></h3>
                <p>{hackathon.prize?.awardSummary ?? hackathon.award}</p>
              </div>
              <dl class="record-values">
                <div>
                  <dt>Team</dt>
                  <dd>{formatPrizeAmount(amount.team, amount.currency)}</dd>
                </div>
                <div>
                  <dt>My share</dt>
                  <dd>{formatPrizeAmount(amount.individual, amount.currency)}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </section>

    <section class="fx-reference" aria-label="FX calculation reference">
      <div>
        <p class="meta">FX calculation reference</p>
        <p>Monthly rates used for the converted totals.</p>
      </div>
      <button class="fx-open" type="button" aria-haspopup="dialog" aria-controls="fx-rate-dialog">View rate table <span aria-hidden="true">↗</span></button>
    </section>
  </main>
</PageShell>

<style>
  .awards-page { padding: 78px 0 24px; }
  .intro { max-width: 760px; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 22px; color: var(--ink); font-size: clamp(3.3rem, 8vw, 7.4rem); line-height: .9; letter-spacing: -.055em; }
  .lead { margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .record-category { margin-bottom: 8px; color: var(--faint); font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  dl { margin: 0; }
  dt { color: var(--muted); font-size: .76rem; font-weight: 800; }
  dd { margin: 6px 0 0; color: var(--ink); font-size: 1.08rem; font-weight: 950; font-variant-numeric: tabular-nums; }
  .breakdown, .records { margin-top: 86px; }
  .fx-section { margin-top: 86px; }
  .section-title { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .6fr); gap: 34px; align-items: end; margin-bottom: 26px; }
  .section-title h2 { margin-bottom: 0; color: var(--ink); font-size: clamp(2.3rem, 5vw, 4.6rem); line-height: .92; letter-spacing: -.045em; }
  .section-title > p { margin-bottom: 0; color: var(--muted); line-height: 1.6; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line-strong); background: var(--bg-paper); }
  table { width: 100%; border-collapse: collapse; min-width: 660px; }
  th { padding: 14px 18px; background: var(--ink); color: white; font-size: .75rem; letter-spacing: .08em; text-align: left; text-transform: uppercase; }
  th:nth-child(n+3), td:nth-child(n+3) { text-align: right; }
  td { padding: 17px 18px; border-top: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  td:first-child { font-weight: 850; }
  td:nth-child(n+3) { color: var(--ink); font-weight: 900; }
  .record-list { border-top: 1px solid var(--line-strong); }
  .record { display: grid; grid-template-columns: 68px minmax(0, 1fr) minmax(220px, auto); gap: 18px; align-items: center; padding: 23px 0; border-bottom: 1px solid var(--line); }
  .record-number { color: var(--red); font-size: .9rem; font-weight: 950; }
  .record-copy h3 { margin-bottom: 6px; color: var(--ink); font-size: 1.05rem; }
  .record-copy h3 a:hover { color: var(--red); }
  .record-copy > p:last-child { margin-bottom: 0; color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .record-values { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; min-width: 230px; }
  .record-values dd { font-size: .95rem; }
  @media (max-width: 760px) {
    .awards-page { padding-top: 54px; }
    .section-title { grid-template-columns: 1fr; gap: 14px; }
    .record { grid-template-columns: 52px 1fr; }
    .record-values { grid-column: 2; min-width: 0; }
  }
</style>

<style is:global>
  .overview-heading { margin-bottom: 24px; }
  .overview-heading .meta { margin-bottom: 8px; }
  .overview-heading h2 { margin: 0 0 10px; color: var(--ink); font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: .95; letter-spacing: -.045em; }
  .overview-controls { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .overview-controls p { margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.5; }
  .conversion-toggle { display: inline-flex; align-items: center; gap: 8px; flex: none; padding: 2px 0 4px; border: 0; border-bottom: 1px solid var(--red); background: transparent; color: var(--ink); cursor: pointer; font: inherit; font-size: .88rem; font-weight: 850; white-space: nowrap; }
  .conversion-toggle:hover, .conversion-toggle:focus-visible { color: var(--red); }
  .conversion-toggle:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
  .conversion-icon { color: var(--red); font-size: 1.15rem; line-height: 1; }
  .currency-combined[hidden], .pending-note[hidden] { display: none !important; }
  .currency-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .currency-card { overflow: hidden; border: 1px solid var(--line-strong); border-top: 6px solid var(--red); background: var(--bg-paper); box-shadow: var(--shadow); }
  .currency-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--line); }
  .currency-card-head h3 { margin: 0; color: var(--red); font-size: 1.5rem; line-height: 1; }
  .currency-card-head span { color: var(--muted); font-size: .76rem; font-weight: 700; }
  .currency-combined { padding: 18px 22px 22px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 2%, var(--bg-paper)); }
  .currency-combined > p { margin: 0 0 18px; color: var(--ink); font-size: .9rem; font-weight: 900; }
  .currency-card dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .currency-card dt { color: var(--muted); font-size: .77rem; font-weight: 800; }
  .currency-card dd { margin: 6px 0 0; color: var(--ink); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .currency-combined dd { font-size: 1.05rem; font-weight: 850; }
  .currency-original { padding: 20px 22px 24px; }
  .currency-original > p { margin: 0 0 18px; color: var(--ink); font-size: .9rem; font-weight: 900; }
  .currency-original dd { font-size: clamp(1.3rem, 2.35vw, 2.1rem); font-weight: 950; letter-spacing: -.025em; }
  .pending-note { margin-top: 16px; border-left: 3px solid var(--red); background: var(--bg-paper); }
  .pending-note summary { display: flex; justify-content: space-between; gap: 12px; padding: 13px 17px; color: var(--ink); cursor: pointer; font-size: .88rem; font-weight: 800; list-style: none; }
  .pending-note summary::-webkit-details-marker { display: none; }
  .pending-note summary span { color: var(--red); white-space: nowrap; }
  .pending-note > p { margin: 0; padding: 0 17px 8px; color: var(--muted); font-size: .85rem; }
  .pending-note ul { margin: 0; padding: 0 17px 16px 36px; color: var(--muted); font-size: .85rem; line-height: 1.6; }
  .category-currency-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .category-currency-card { min-width: 0; border: 1px solid var(--line-strong); border-top: 5px solid var(--ink); background: var(--bg-paper); }
  .category-currency-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 17px 20px; border-bottom: 1px solid var(--line); }
  .category-currency-head h3 { margin: 0; color: var(--red); font-size: 1.4rem; line-height: 1; }
  .category-currency-head span { color: var(--muted); font-size: .76rem; font-weight: 700; }
  .category-column-head, .category-amount-row { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); gap: 8px; align-items: center; padding: 12px 20px; }
  .category-column-head { color: var(--muted); font-size: .73rem; font-weight: 850; }
  .category-amount-row { min-height: 58px; border-top: 1px solid var(--line); }
  .category-amount-row strong { color: var(--ink); font-size: .9rem; line-height: 1.25; }
  .category-amount-row span { color: var(--ink); font-size: .95rem; font-weight: 850; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .category-amount-row span:nth-child(3) { font-weight: 900; }
  .category-key { margin: 10px 0 0; color: var(--muted); font-size: .8rem; }
  @media (max-width: 700px) { .currency-grid { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .category-currency-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .overview-controls { align-items: flex-start; flex-direction: column; gap: 10px; }
    .pending-note summary { flex-direction: column; gap: 3px; }
  }
</style>

<style is:global>
  .fx-reference { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 44px; padding: 20px 0 0; border-top: 1px solid var(--line-strong); }
  .fx-reference .meta { margin: 0 0 5px; color: var(--faint); font-size: .68rem; letter-spacing: .08em; }
  .fx-reference p:last-child { margin: 0; color: var(--muted); font-size: .86rem; line-height: 1.4; }
  @media (max-width: 760px) { .fx-reference { align-items: flex-start; flex-direction: column; gap: 12px; } }
</style>

<style is:global>
  .awards-page:has(.fx-reference) { padding-bottom: 24px; }
</style>

<style is:global>
  .fx-open { min-height: 40px; padding: 0 0 2px; border: 0; border-bottom: 1px solid currentColor; border-radius: 0; background: transparent; color: var(--ink); cursor: pointer; font: inherit; font-size: .88rem; font-weight: 800; white-space: nowrap; }
  .fx-open span { margin-left: 5px; color: var(--red); }
  .fx-open:hover, .fx-open:focus-visible { color: var(--red); }
  .fx-dialog { width: min(860px, calc(100vw - 32px)); max-height: min(760px, calc(100vh - 32px)); padding: 24px; border: 1px solid var(--line-strong); border-top: 6px solid var(--red); background: var(--bg-paper); box-shadow: var(--shadow); color: var(--ink); }
  .fx-dialog::backdrop { background: rgb(0 0 0 / 65%); }
  .fx-dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .fx-dialog h3 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1; }
  .fx-close { width: 42px; height: 42px; border: 1px solid var(--line-strong); background: transparent; color: var(--ink); cursor: pointer; font-size: 1.8rem; line-height: 1; }
  .fx-close:hover, .fx-close:focus-visible { border-color: var(--red); color: var(--red); }
  .fx-dialog > p { margin: 18px 0; color: var(--muted); line-height: 1.6; }
  .fx-dialog a { color: var(--red); text-decoration: underline; }
</style>

<script>
  const conversionToggle = document.querySelector<HTMLButtonElement>(".conversion-toggle");
  conversionToggle?.addEventListener("click", () => {
    const show = conversionToggle.getAttribute("aria-expanded") !== "true";
    conversionToggle.setAttribute("aria-expanded", String(show));
    const conversionLabel = conversionToggle.querySelector<HTMLElement>(".conversion-label");
    if (conversionLabel) conversionLabel.textContent = show ? "Hide FX conversion" : "Show FX conversion";
    document.querySelectorAll<HTMLElement>(".currency-combined, .pending-note").forEach((element) => {
      element.hidden = !show;
    });
  });
  const fxDialog = document.querySelector<HTMLDialogElement>("#fx-rate-dialog");
  document.querySelector<HTMLButtonElement>(".fx-open")?.addEventListener("click", () => fxDialog?.showModal());
  document.querySelector<HTMLButtonElement>(".fx-close")?.addEventListener("click", () => fxDialog?.close());
  fxDialog?.addEventListener("click", (event) => {
    if (event.target === fxDialog) fxDialog.close();
  });
</script>
