---
import PageShell from "../../components/PageShell.astro";
import ProjectCaseStudy from "../../components/ProjectCaseStudy.astro";
import ProjectExhibit from "../../components/ProjectExhibit.astro";
import ProjectNavigation from "../../components/ProjectNavigation.astro";
import ProjectTransition from "../../components/ProjectTransition.astro";
import ProjectTeam from "../../components/ProjectTeam.astro";
import { projectArt } from "../../lib/project-art";
import { getCaseStudy } from "../../lib/case-studies";
import { getHackathons, type Hackathon } from "../../lib/hackathons";

export function getStaticPaths() {
  return getHackathons().map((hackathon) => ({
    params: { number: String(hackathon.number) },
    props: { hackathon },
  }));
}

const { hackathon } = Astro.props as { hackathon: Hackathon };
const orderedProjects = [...getHackathons()].sort((a, b) => a.number - b.number);
const projectIndex = orderedProjects.findIndex((project) => project.number === hackathon.number);
const previous = orderedProjects[projectIndex - 1];
const next = orderedProjects[projectIndex + 1];
const caseStudy = getCaseStudy(hackathon.number);
const description = `Hackathon #${hackathon.number}: ${hackathon.title}, built for ${hackathon.event}. ${hackathon.solution || [hackathon.dateLabel, hackathon.award].filter(Boolean).join(". ")}`;
const duration =
  hackathon.duration && hackathon.durationUnit
    ? `${hackathon.duration} ${hackathon.durationUnit}`
    : null;
const details = [
  ["Event", hackathon.event],
  ["Organizers", hackathon.organizers.join(" · ")],
  ["Date", hackathon.dateLabel],
  ["Duration", duration],
  ["Focus", hackathon.tags.join(" · ")],
  ["Award", hackathon.award],
  ["Client", hackathon.client],
  ["Location", [hackathon.location, hackathon.country].filter(Boolean).join(", ")],
].filter(([, value]) => Boolean(value));
const socialPlatforms = [
  { key: "linkedin", label: "LinkedIn", urls: hackathon.socialLinks.linkedin },
  { key: "instagram", label: "Instagram", urls: hackathon.socialLinks.instagram },
  { key: "facebook", label: "Facebook", urls: hackathon.socialLinks.facebook },
].filter((platform) => platform.urls.length);
---

<PageShell title={`${hackathon.title} | The 100 Hackathoner`} description={description}>
  <ProjectTransition />
  <article class="record container">
    <div class="record-toolbar">
      <a class="back" id="record-back" href="/hackathons/">Back to journey</a>
      <ProjectNavigation previous={previous} next={next} position="top" />
    </div>
    <p class="meta">Hackathon #{String(hackathon.number).padStart(3, "0")}</p>
    <h1>{hackathon.title}</h1>
    <p class="event">{hackathon.event}</p>

    {
      hackathon.solution && (
        <section class="summary">
          <p class="meta">What We Built</p>
          <p>{hackathon.solution}</p>
        </section>
      )
    }

    {projectArt[hackathon.number] && <ProjectExhibit number={hackathon.number} title={hackathon.title} art={projectArt[hackathon.number]} />}

    <dl class="details">
      {
        details.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    {caseStudy && <ProjectCaseStudy study={caseStudy} hackathon={hackathon} />}

    <ProjectTeam members={hackathon.members} />

    {
      (hackathon.githubUrl || hackathon.eventUrl) && (
        <div class="links" aria-label="Hackathon links">
          {hackathon.githubUrl && (
            <a href={hackathon.githubUrl} rel="noreferrer" target="_blank">Source code</a>
          )}
          {hackathon.eventUrl && (
            <a href={hackathon.eventUrl} rel="noreferrer" target="_blank">Event page</a>
          )}
        </div>
      )
    }

    {
      socialPlatforms.length > 0 && (
        <section class="socials" aria-labelledby="social-posts-heading">
          <p class="meta">Follow the build</p>
          <h2 id="social-posts-heading">Original posts</h2>
          <div class="social-platforms">
            {socialPlatforms.map((platform) => (
              <div class:list={["social-platform", platform.key]}>
                <p>{platform.label}</p>
                <div class="social-posts">
                  {platform.urls.map((url, index) => (
                    <a href={url} rel="noreferrer" target="_blank">
                      {platform.label} post {index + 1}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
    <ProjectNavigation previous={previous} next={next} position="bottom" />
  </article>
</PageShell>

<script>
  const backLink = document.querySelector<HTMLAnchorElement>('#record-back');
  if (backLink && new URLSearchParams(window.location.search).get('from') === 'landing') {
    backLink.href = '/#collection';
    backLink.textContent = 'Back to collection';
    document.querySelectorAll<HTMLAnchorElement>('[data-project-link]').forEach((link) => {
      const url = new URL(link.href);
      url.searchParams.set('from', 'landing');
      link.href = url.href;
    });
  }
</script>

<style>
  .record {
    --detail-label-size: .72rem;
    --detail-value-size: 1.1rem;
    max-width: 920px;
    padding-top: 104px;
    padding-bottom: 88px;
  }

  .record-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 48px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--red);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .meta {
    margin: 0;
    color: var(--red);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 850px;
    margin: 14px 0 0;
    color: var(--ink);
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .event {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .summary {
    max-width: 780px;
    margin-top: 64px;
  }

  .summary > p:last-child {
    margin: 12px 0 0;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.3;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 42px;
    margin: 64px 0 0;
    border-top: 1px solid var(--line);
  }

  .details div {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
    font-family: var(--body);
    font-size: var(--detail-label-size);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 8px 0 0;
    color: var(--ink);
    font-size: var(--detail-value-size);
    font-weight: 500;
    line-height: 1.5;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 11px 20px;
  }

  .links a:hover { border-color: var(--ink); background: var(--raised); }
  .links a:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }

  .socials {
    margin-top: 68px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .socials h2 {
    margin: 10px 0 0;
    color: var(--ink);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    letter-spacing: -0.04em;
  }

  .social-platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .social-platform {
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--line-strong);
    background: var(--bg-paper);
  }

  .social-platform > p {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .social-platform.linkedin > p { color: #0a66c2; }
  .social-platform.instagram > p { color: #c13584; }
  .social-platform.facebook > p { color: #1877f2; }

  .social-posts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .social-posts a {
    border-bottom: 1px solid currentColor;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .social-posts a:hover { color: var(--red); }

  @media (max-width: 640px) {
    .record-toolbar { gap: 12px; margin-bottom: 36px; }
    .back { font-size: .68rem; letter-spacing: .02em; }
    .details {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .social-platforms {
      grid-template-columns: 1fr;
    }
  }
</style>
