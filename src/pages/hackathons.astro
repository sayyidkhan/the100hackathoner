---
import { getHackathons } from "../lib/hackathons";
import PageShell from "../components/PageShell.astro";
import HackathonTimeline from "../components/HackathonTimeline.astro";
import HackathonTable from "../components/HackathonTable.astro";
import JourneyInfographic from "../components/JourneyInfographic.astro";
import { buildTotals } from "../lib/insights";

const hackathons = getHackathons();

const GOAL = 100;
const totals = buildTotals(hackathons, GOAL);

---

<PageShell title="Journey Map | The 100 Hackathoner">
  <section class="archive-hero container">
    <div class="hero-top">
      <div class="hero-copy">
        <p class="meta">
          {
            totals.firstYear && totals.latestYear
              ? `${totals.firstYear} — ${totals.latestYear}`
              : "The log"
          }
        </p>
        <h1>Journey Map</h1>
        <p class="lead">
          A running record of the 100-hackathon journey: what was built, where it
          happened, who joined, and what shipped before demo day.
        </p>
      </div>

      <div class="counter" aria-hidden="true">
        <span class="counter-value">
          {String(totals.logged).padStart(3, "0")}
        </span>
        <span class="counter-goal">/ {GOAL}</span>
        <span class="counter-label">Logged</span>
      </div>
    </div>

    <div class="journey-nav">
      <p>{totals.logged} logged <span aria-hidden="true">/</span> {totals.remaining} to go</p>
      <div class="switch" role="group" aria-label="Journey view">
        <button type="button" data-view="list" aria-pressed="true">
          Timeline
        </button>
        <button type="button" data-view="chart" aria-pressed="false">
          Infographic
        </button>
      </div>
    </div>
  </section>

  <section class="archive-body container" data-view-panel="list">
    <div class="archive-toolbar">
      <p>Browse the archive</p>
      <div class="archive-switch" role="group" aria-label="Timeline layout">
        <button type="button" data-archive-view="cards" aria-pressed="true">
          Cards
        </button>
        <button type="button" data-archive-view="table" aria-pressed="false">
          Table
        </button>
      </div>
    </div>

    <div data-archive-panel="cards">
      <HackathonTimeline items={hackathons} />
    </div>
    <div data-archive-panel="table" hidden>
      <HackathonTable items={hackathons} />
    </div>
  </section>

  <section class="archive-body container" data-view-panel="chart" hidden>
    <JourneyInfographic items={hackathons} goal={GOAL} />
  </section>
</PageShell>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-view]");
  const panels = document.querySelectorAll<HTMLElement>("[data-view-panel]");
  const archiveButtons = document.querySelectorAll<HTMLButtonElement>("[data-archive-view]");
  const archivePanels = document.querySelectorAll<HTMLElement>("[data-archive-panel]");

  function apply(mode: string) {
    for (const panel of panels) {
      panel.hidden = panel.dataset.viewPanel !== mode;
    }

    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.view === mode));
    }
  }

  function fromHash() {
    return location.hash === "#infographic" ? "chart" : "list";
  }

  function applyArchiveView(mode: string) {
    for (const panel of archivePanels) {
      panel.hidden = panel.dataset.archivePanel !== mode;
    }

    for (const button of archiveButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.archiveView === mode),
      );
    }
  }

  function archiveViewFromHash() {
    return location.hash === "#table" ? "table" : "cards";
  }

  function activeArchiveView() {
    return (
      [...archiveButtons].find(
        (button) => button.getAttribute("aria-pressed") === "true",
      )?.dataset.archiveView ?? "cards"
    );
  }

  apply(fromHash());
  applyArchiveView(archiveViewFromHash());

  // A hash-only navigation does not reload the document, so react to it.
  window.addEventListener("hashchange", () => {
    apply(fromHash());
    applyArchiveView(archiveViewFromHash());
  });

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const mode = button.dataset.view ?? "list";
      apply(mode);
      history.replaceState(
        null,
        "",
        mode === "chart"
          ? "#infographic"
          : activeArchiveView() === "table"
            ? "#table"
            : location.pathname,
      );
    });
  }

  for (const button of archiveButtons) {
    button.addEventListener("click", () => {
      const mode = button.dataset.archiveView ?? "cards";
      applyArchiveView(mode);
      history.replaceState(null, "", mode === "table" ? "#table" : location.pathname);
    });
  }
</script>

<style>
  .archive-hero {
    padding: 72px 0 0;
  }

  .archive-body {
    padding: 26px 0 96px;
  }

  .archive-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 20px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .archive-toolbar > p {
    margin: 0;
    color: var(--faint);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .archive-switch {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    background: var(--bg-paper);
  }

  .archive-switch button {
    min-height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .archive-switch button:hover {
    color: var(--ink);
  }

  .archive-switch button[aria-pressed="true"] {
    background: var(--ink);
    color: white;
  }

  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: end;
  }

  h1 {
    margin: 12px 0 0;
    color: var(--ink);
    font-size: clamp(3.5rem, 9vw, 8.5rem);
    font-weight: 950;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .lead {
    max-width: 54ch;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  /* Counter ----------------------------------------------------------- */

  .counter {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    justify-items: end;
    padding-bottom: 6px;
  }

  .counter-value {
    color: var(--red);
    font-size: clamp(3.2rem, 7vw, 5.2rem);
    font-weight: 950;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.06em;
    line-height: 0.82;
  }

  .counter-goal {
    margin-left: 8px;
    color: var(--faint);
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .counter-label {
    grid-column: 1 / -1;
    margin-top: 10px;
    color: var(--faint);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* View switch ------------------------------------------------------- */

  .journey-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
  }

  .journey-nav > p {
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journey-nav > p span {
    color: var(--red);
    padding: 0 5px;
  }

  .switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg-paper);
  }

  .switch button {
    min-height: 38px;
    padding: 0 18px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .switch button:hover {
    color: var(--ink);
  }

  .switch button[aria-pressed="true"] {
    background: var(--ink);
    color: white;
  }

  @media (max-width: 900px) {
    .archive-hero {
      padding-top: 52px;
    }

    .hero-top {
      grid-template-columns: 1fr;
      gap: 26px;
      align-items: start;
    }

    .counter {
      justify-items: start;
      justify-content: start;
    }

    .archive-toolbar {
      align-items: stretch;
    }

    .archive-switch {
      width: 100%;
    }

    .archive-switch button {
      flex: 1;
    }
  }

  @media (max-width: 560px) {
    .journey-nav {
      align-items: stretch;
      flex-direction: column;
    }

    .switch {
      width: 100%;
    }

    .switch button {
      flex: 1;
      padding: 0 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .switch button {
      transition: none;
    }
  }
</style>
