---
import { getImage } from 'astro:assets';
import ScaleupJourney from './ScaleupJourney.astro';
import type { ProjectArt } from '../lib/project-art';
interface Props { number: number; title: string; art: ProjectArt; projectUrl?: string | null; }
const { number, title, art, projectUrl: catalogProjectUrl } = Astro.props;
// Published homepage listed by github.com/sayyidkhan/v0-data-center-tycoon.
// Use the standard exhibit card for projects without a deployment URL.
// Expanded promotional treatments are reserved for deployed projects.
const projectUrl = catalogProjectUrl ?? (number === 63 ? 'https://v0-data-center-tycoon.vercel.app/' : null);
const isScaleup = [36, 37, 38].includes(number);
const hasLabels = [74, 75, 76].includes(number);
async function variants(src: ProjectArt['light']) {
  const images = await Promise.all([480, 800, 1200, 1536].map(width => getImage({ src, width, format: 'webp', quality: 80 })));
  return { src: images[2].src, srcset: images.map((image, i) => `${image.src} ${[480, 800, 1200, 1536][i]}w`).join(', ') };
}
// Buzo Atlas labels follow gr-atlas/docs/PRODUCT_THESIS.md, “Four mechanisms”.
// Telepath roles and synthesis output match server.ts PERSPECTIVE_PROMPTS.
const divisions = number === 74 ? [
  { id: 'proposal', name: 'Feature Proposal', purpose: 'The concept to stress-test', x: 50, y: 19 },
  { id: 'tech', name: 'Tech & Architecture', purpose: 'Data, APIs & technical edge cases', x: 21, y: 40 },
  { id: 'finance', name: 'Finance & Accounting', purpose: 'Tax, refunds & ledger risks', x: 21, y: 70 },
  { id: 'legal', name: 'Legal & Regulatory', purpose: 'Consumer rights & disclosures', x: 80, y: 40 },
  { id: 'operations', name: 'HR & Operations', purpose: 'Training, workflows & staff impact', x: 80, y: 70 },
  { id: 'checklist', name: 'Pre-Sprint Checklist', purpose: 'Synthesized risks & action items', x: 50, y: 81 },
] : number === 75 ? [
  { id: 'partnerships', name: 'Strategic Partnerships', purpose: 'Connect artists, venues & brands', x: 79, y: 77 },
  { id: 'originals', name: 'Buzo Originals', purpose: 'Reusable event formats & rights', x: 25, y: 30 },
  { id: 'art', name: 'Digital Art', purpose: 'Artist collaborations & licences', x: 76, y: 28 },
  { id: 'concierge', name: 'Concierge IP & Technology', purpose: 'Reusable agents & workflows', x: 49, y: 60 },
] : [
  { id: 'community', name: 'Community', purpose: 'Protect the people', x: 19, y: 47 },
  { id: 'academy', name: 'Builder Academy', purpose: 'Teach the builders', x: 50, y: 18 },
  { id: 'machines', name: 'Machine Systems', purpose: 'Keep the city running', x: 82, y: 35 },
  { id: 'mayor', name: 'Mayor Agrim', purpose: 'Lead & balance all three', x: 50, y: 73 },
];
const [light, dark] = await Promise.all([variants(art.light), variants(art.dark)]);
---
{isScaleup && <link rel="stylesheet" href="/landing/scaleup-evolution.css" />}
{number === 41 && <link rel="stylesheet" href="/landing/invitation-studio.css" />}
{number === 39 && <link rel="stylesheet" href="/landing/memory-observatory.css" />}
{number === 67 && <link rel="stylesheet" href="/landing/sceneverse.css" />}
{number === 63 && <link rel="stylesheet" href="/landing/data-center-tycoon.css" />}
{number === 75 && <link rel="stylesheet" href="/landing/buzo-atlas.css" />}
{number === 70 && <link rel="stylesheet" href="/landing/relationship-mapper.css" />}
{number === 49 && <link rel="stylesheet" href="/landing/stress-bunny.css" />}
{number === 57 && <link rel="stylesheet" href="/landing/medivoice.css" />}
{number === 50 && <link rel="stylesheet" href="/landing/magistock.css" />}
{number === 48 && <link rel="stylesheet" href="/landing/jollycards.css" />}
{number === 44 && <link rel="stylesheet" href="/landing/vibewater.css" />}
{number === 40 && <link rel="stylesheet" href="/landing/two-rivers.css" />}
{number === 42 && <link rel="stylesheet" href="/landing/astrodegen.css" />}
{number === 46 && <link rel="stylesheet" href="/landing/hedera-agents.css" />}
<section class="project-exhibit" id={isScaleup ? 'scaleup-evolution' : undefined} data-scaleup={isScaleup || undefined} data-project-exhibit data-number={number} data-model={art.model} aria-label={`${title} concept exhibit`}>
  {isScaleup && <ScaleupJourney number={number} />}
  {number === 63 && <header class="tycoon-intro">
    <div><p class="tycoon-eyebrow"><span></span> DATA CENTER TYCOON · WEB + MOBILE · 063</p>
    <h2>Build an empire.<br /><em>Keep it in balance.</em></h2>
    <p class="tycoon-description">More servers. More ambition. Every decision counts.<br />Grow your revenue while balancing power, cooling and sustainability.</p></div>
    {projectUrl && <a class="tycoon-launch" href={projectUrl} target="_blank" rel="noopener noreferrer">Play the game <span aria-hidden="true">↗</span></a>}
  </header>}
  {number === 70 && <header class="mapper-intro">
    <div><p class="mapper-eyebrow"><span></span> ZO RELATIONSHIP MAPPER · 070</p>
    <h2>Your next role<br />starts with <em>people.</em></h2>
    <p class="mapper-description">Turn your experience into a focused opportunity search.<br />Discover who to approach, and what to say.</p></div>
    {projectUrl && <a class="mapper-launch" href={projectUrl} target="_blank" rel="noopener noreferrer">Explore the app <span aria-hidden="true">↗</span></a>}
  </header>}
  {number === 69 && <header class="order-intro">
    <div><p class="order-eyebrow">ZORDER · THE SMALL BUSINESS EDITION</p>
    <h2>Small shop.<br /><em>Every order in place.</em></h2>
    <p class="order-intro-note">A storefront, a receipt,<br />and a little more order.<span>BUILT ON ZO COMPUTER</span></p></div>
    {projectUrl && <a class="order-launch" href={projectUrl} target="_blank" rel="noopener noreferrer">Explore the app <span aria-hidden="true">↗</span></a>}
  </header>}
  {number === 72 && <header class="cosmic-intro">
    <div><p class="cosmic-eyebrow"><span></span> AN INTERACTIVE STORYWORLD · 072</p>
    <h2>Lost between <em>worlds.</em></h2>
    <p class="cosmic-description">A little traveller. An impossible universe.<br />Three echoes to remember the way home.</p></div>
    {projectUrl && <a class="cosmic-launch" href={projectUrl} target="_blank" rel="noopener noreferrer">Play the game <span aria-hidden="true">↗</span></a>}
  </header>}
  {number === 75 && <header class="atlas-intro">
    <div><p class="atlas-eyebrow"><span></span> BUZO ATLAS · THE CULTURE ECONOMY · 075</p>
    <h2>A world of culture.<br /><em>Connected by Atlas.</em></h2>
    <p class="atlas-description">The people, rights and ideas behind the next great night.<br /> One shared map to learn, coordinate and decide.</p></div>
    {projectUrl && <a class="atlas-launch" href={projectUrl} target="_blank" rel="noopener noreferrer">Explore the app <span aria-hidden="true">↗</span></a>}
  </header>}
  <div class="exhibit-toolbar">
    <p>{isScaleup ? 'THE SAME IDEA, EXPANDING' : number === 41 ? 'PROMPT ALCHEMIST · THE INVITATION STUDIO' : number === 45 ? 'ASTERIX · THE VIBE CHECK CONSOLE' : number === 63 ? 'INSIDE THE DATA CENTER EMPIRE' : number === 75 ? 'THE LIVING CULTURAL ATLAS' : number === 70 ? 'THE OPPORTUNITY ATLAS' : number === 72 ? 'EXPLORE THE THRESHOLD' : number === 69 ? 'INSIDE THE LITTLE SHOP' : 'THE PROJECT, REIMAGINED'}</p>
    <div class="exhibit-actions">
      {number === 72 && projectUrl && <a class="cosmic-launch cosmic-toolbar-launch" href={projectUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Alien Homecoming app (opens in a new tab)">Open app <span aria-hidden="true">↗</span></a>}
      {hasLabels && <button type="button" data-toggle-labels aria-expanded={number === 75 ? 'false' : 'true'}>{number === 75 ? 'Show labels' : 'Hide labels'}</button>}
    <div role="group" aria-label="Display mode" class="exhibit-modes">
      <button type="button" data-mode="artwork" aria-pressed="true">Artwork</button>
      <button type="button" data-mode="3d" aria-pressed="false">Explore in 3D</button>
    </div>
    </div>
  </div>
  <figure>
    <div class="exhibit-art" data-art>
      <picture>
        <source data-dark-art media="(prefers-color-scheme: dark)" srcset={dark.srcset} sizes="(max-width: 920px) 100vw, 920px" type="image/webp" />
        <img src={light.src} srcset={light.srcset} sizes="(max-width: 920px) 100vw, 920px" width="1536" height="1024" alt={art.alt} loading="lazy" decoding="async" />
      </picture>
      {hasLabels && <div class="division-labels" aria-hidden="true" hidden={number === 75}>
        {divisions.map((division, index) => <div class="division-label" data-division={division.id} style={`left:${division.x}%;top:${division.y}%`}>
          <span class="division-number">{index + 1}</span>
          <span class="division-copy"><strong>{division.name}</strong><small>{division.purpose}</small></span>
        </div>)}
      </div>}
    </div>
    <div class="exhibit-scene" data-scene hidden>
      <canvas tabindex="0" aria-label={number === 49 ? 'Interactive bunny meadow. Drag the bunny to pick it up; release to drop. Space picks up or releases; arrow keys move it while held. Drag the garden to rotate. Home resets.' : `Interactive 3D concept for ${title}. Drag or use arrow keys to rotate.`}></canvas>
      {number === 49 && <p class="bunny-interaction-hint" data-manipulation-status aria-live="polite">Pick up the bunny. Let it go. Let it rest.</p>}
      {number === 67 && <div class="scene-speech" data-scene-speech hidden aria-live="off">
        <strong data-speech-speaker></strong><p data-speech-text></p>
      </div>}
      {hasLabels && <div class="division-labels" aria-hidden="true" hidden={number === 75}>
        {divisions.map((division, index) => <div class="division-label" data-division={division.id} style={`left:${division.x}%;top:${division.y}%`}>
          <span class="division-number">{index + 1}</span>
          <span class="division-copy"><strong>{division.name}</strong><small>{division.purpose}</small></span>
        </div>)}
      </div>}
      {(number === 69 || number === 70 || number === 72 || number === 55 || number === 58 || number === 59 || number === 82) && <div class="exhibit-story" data-story aria-live="off" hidden>
        <p class="exhibit-story-heading"><span class="exhibit-story-dot" aria-hidden="true"></span><span class="exhibit-story-step" data-story-step></span><span data-story-title></span></p>
        <p class="exhibit-story-detail" data-story-detail></p>
      </div>}
    </div>
    {number === 41 && <div class="invitation-journey" aria-label="The event funnel">
      <span><b>01</b> Attract attention</span><span aria-hidden="true">→</span>
      <span><b>02</b> Make the invitation</span><span aria-hidden="true">→</span>
      <span><b>03</b> Bring people together</span>
    </div>}
    <div class="exhibit-controls" data-controls hidden>
      <span>{number === 49 ? 'Drag bunny to lift · Release to drop · Space + arrows also work' : 'Drag to rotate · Arrow keys to turn'}</span>
      {number === 35 && <><button type="button" data-zoom="0.8" aria-label="Zoom out" disabled>−</button><button type="button" data-zoom="1.25" aria-label="Zoom in">+</button></>}
      <button type="button" data-reset>{number === 49 ? 'Reset meadow' : 'Reset view'}</button>
      <button type="button" data-pause aria-pressed="false">Pause motion</button>
    </div>
    {isScaleup && <div class="exhibit-walkthrough" data-walkthrough hidden>
      <div class="exhibit-story" data-story aria-live="off" hidden>
        <p class="exhibit-story-heading"><span class="exhibit-story-step" data-story-step></span><span data-story-title></span></p>
        <p class="exhibit-story-detail" data-story-detail></p>
      </div>
      <div class="walkthrough-steps" role="group" aria-label="Compare the three ScaleUp AI editions in 3D">
        {['Consulting idea', 'Operating platform', 'VR edition'].map((label,index) => <button type="button" data-story-select={index} aria-pressed={index===number-36?'true':'false'}><span>0{index+1}</span> {label}</button>)}
        <button type="button" data-story-auto aria-pressed="false">Play evolution</button>
      </div>
    </div>}
    {number === 57 && <div class="exhibit-walkthrough medi-walkthrough" data-walkthrough hidden>
      <div class="exhibit-story" data-story aria-live="off" hidden>
        <p class="exhibit-story-heading"><span class="exhibit-story-dot" aria-hidden="true"></span><span class="exhibit-story-step" data-story-step></span><span data-story-title></span></p>
        <p class="exhibit-story-detail" data-story-detail></p>
      </div>
      <div class="walkthrough-steps" role="group" aria-label="MediVoice care journey">
        {['Voice consultation', 'Case summary', 'Doctor review', 'Digital MC'].map((label,index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index+1).padStart(2,'0')}</span>{label}</button>)}
      </div>
      <button type="button" class="medi-autoplay" data-story-auto aria-pressed="true">Auto-play journey</button>
    </div>}
    {number === 54 && <div class="exhibit-walkthrough gigradar-walkthrough" data-walkthrough hidden>
      <div class="exhibit-story" data-story aria-live="off" hidden>
        <p class="exhibit-story-heading"><span class="exhibit-story-dot" aria-hidden="true"></span><span class="exhibit-story-step" data-story-step></span><span data-story-title></span></p>
        <p class="exhibit-story-detail" data-story-detail></p>
      </div>
      <div class="walkthrough-steps" role="group" aria-label="Gigradar walkthrough steps">
        {['Ask nearby', 'Discover', 'Verify', 'Imagine after'].map((label, index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span> {label}</button>)}
        <button type="button" data-story-auto aria-pressed="true">Auto-play steps</button>
      </div>
      <p>Artist’s impression · Illustrative venues and activity preview, inspired by the hackathon demo.</p>
    </div>}
    {number === 67 && <div class="exhibit-walkthrough sceneverse-walkthrough" data-walkthrough hidden>
      <div class="exhibit-story" style="position: static; max-width: none; margin-bottom: 16px;" data-story aria-live="off" hidden>
        <p class="exhibit-story-heading"><span class="exhibit-story-dot" aria-hidden="true"></span><span class="exhibit-story-step" data-story-step></span><span data-story-title></span></p>
        <p class="exhibit-story-detail" data-story-detail></p>
      </div>
      <div class="walkthrough-steps" role="group" aria-label="SceneVerse experience">
        {['Watch', 'Enter the scene', 'Ask Maya', 'Ask Riven'].map((label,index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>)}
        <button type="button" data-story-auto aria-pressed="true">Auto-play</button>
      </div>
      <p>Illustrative dialogue · Stay seated, say “Enter the scene”, then ask the movie characters.</p>
    </div>}
    {number === 70 && <div class="mapper-walkthrough" data-walkthrough hidden>
      <div class="mapper-steps" role="group" aria-label="Relationship Mapper walkthrough">
        {['Your profile', 'Choose a role', 'Find people', 'Draft outreach'].map((label,index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index+1).padStart(2,'0')}</span>{label}</button>)}
        <button type="button" data-story-auto aria-pressed="true">Auto-play</button>
      </div>
      <p>Concept walkthrough · Illustrative cards, not live search results.</p>
    </div>}
    {number === 69 && <div class="exhibit-walkthrough order-walkthrough" data-walkthrough hidden>
      <div class="walkthrough-steps" role="group" aria-label="Order workflow steps">
        {['Browse', 'Upload proof', 'Review', 'Fulfil'].map((label, index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span> {label}</button>)}
        <button type="button" data-story-auto aria-pressed="true">Auto-play steps</button>
      </div>
      <p>Illustrative workflow · Payment proof is reviewed by the merchant.</p>
    </div>}
    {number === 82 && <div class="exhibit-walkthrough" data-walkthrough hidden>
      <div class="walkthrough-steps" role="group" aria-label="FitStake walkthrough steps">
        {['Challenge', 'Rewards', 'Card & cap', 'Compete', 'Settle'].map((label, index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span> {label}</button>)}
        <button type="button" data-story-auto aria-pressed="true">Auto-play steps</button>
      </div>
      <p>Sandbox demo · Simulated activity · Each reward purchase needs approval.</p>
    </div>}
    {hasLabels && <ol class="division-key" aria-label={number === 74 ? "Telepath reviewers and workflow" : number === 75 ? "Buzo Atlas pillars and their purposes" : "City divisions and their purposes"}>
      {divisions.map((division, index) => <li><span class="division-number">{index + 1}</span><span><strong>{division.name}</strong><small>{division.purpose}</small></span></li>)}
    </ol>}
    {number === 63 ? <figcaption class="tycoon-caption">
      <div><span class="tycoon-eyebrow">THE BALANCING ACT</span><p>Every rack raises the stakes.</p><small>{art.caption}</small></div>
      <div class="tycoon-facts" aria-label="Three operating priorities"><span><b>Grow</b>revenue</span><span><b>Power</b>the servers</span><span><b>Cool</b>the campus</span></div>
    </figcaption> : number === 75 ? <figcaption class="atlas-caption">
      <div><span class="atlas-eyebrow">FROM SCATTERED SIGNALS TO SHARED CONTEXT</span><p>Every connection opens a possibility.</p><small>{art.caption}</small></div>
      <div class="atlas-facts"><span><b>04</b>connected pillars</span><span><b>03</b>operating jobs</span><span><b>01</b>shared atlas</span></div>
    </figcaption> : number === 70 ? <figcaption class="mapper-caption">
      <div><span class="mapper-eyebrow">FROM FIT TO FIRST CONVERSATION</span><p>{art.caption}</p></div>
      <div class="mapper-key"><span><i></i>Hiring managers</span><span><i></i>Mentors</span><span><i></i>Role colleagues</span></div>
    </figcaption> : number === 72 ? <figcaption class="cosmic-caption">
      <div><span class="cosmic-eyebrow">THE JOURNEY</span><p>{art.caption}</p><small>AI-painted realms, unexpected doorways, and a small traveller finding where they belong.</small></div>
      <div class="cosmic-facts"><span><b>10</b>realm families</span><span><b>03</b>home echoes</span><span><b>01</b>way home</span></div>
    </figcaption> : <figcaption>{art.caption}<small>{isScaleup ? 'Concept artwork and interactive 3D interpretation of three evolving hackathon builds.' : number === 41 ? 'Campaign creative, a compelling invitation, and a reason to show up. Inspired by the NAS.IO hackathon build.' : number === 45 ? 'Inspired by the vibe-coding assessment demo. The dial is illustrative, not a live assessment result.' : 'Concept artwork and a 3D interpretation of the project.'}</small></figcaption>}
  </figure>
  <p class="exhibit-status" role="status" data-status></p>
</section>
<script is:inline type="module" src="/landing/project-exhibit.js"></script>
<style is:inline>
  .project-exhibit[data-number='69'] { --order-teal:#25463e; --order-gold:#a17842; border-radius:20px; }
  .order-intro { display:flex; justify-content:space-between; align-items:center; gap:28px; padding:32px 32px 28px; background:#eee6d5; color:#25463e; }
  .order-eyebrow { margin:0 0 16px; font:9px/1.5 var(--mono); letter-spacing:.17em; color:#816641; }
  .order-intro h2 { margin:0; font:500 clamp(32px,4.3vw,52px)/1.06 Georgia,serif; letter-spacing:-.045em; }
  .order-intro h2 em { color:#ad523b; font-weight:400; }
  .order-intro-note { margin:18px 0 0; font-size:12px; line-height:1.7; }
  .order-launch { display:inline-flex; align-items:center; gap:25px; flex-shrink:0; padding:13px 19px; background:#e5cf9b; border-radius:30px; color:#193628; font-size:12px; text-decoration:none; }
  .order-launch:hover { background:#f2deb1; }
  .order-launch:focus-visible { outline:2px solid var(--order-gold); outline-offset:5px; }
  .order-intro-note span { display:block; margin-top:20px; font:8px/1.5 var(--mono); letter-spacing:.10em; color:#816641; }
  .project-exhibit[data-number='69'] .exhibit-toolbar { padding:13px 24px; }
  .project-exhibit[data-number='69'] .exhibit-toolbar p { font-size:9px; letter-spacing:.13em; }
  .project-exhibit[data-number='69'] .exhibit-story { top:16px; left:20px; background:color-mix(in srgb,var(--bg) 90%,transparent); border:1px solid var(--line); padding:10px 14px; border-radius:10px; }
  .project-exhibit[data-number='69'] .exhibit-story-heading { font-size:12px; }
  .project-exhibit[data-number='69'] .exhibit-story-detail { font-size:10px; }
  .project-exhibit[data-number='69'] .exhibit-walkthrough button { font-size:11px; padding:9px 12px; }
  .project-exhibit[data-number='69'] .exhibit-walkthrough button[aria-pressed='true'] { background:#25463e; color:#f6e9d0; }
  :root[data-theme='dark'] .order-intro { background:#172a28; color:#f0e1c5; }
  :root[data-theme='dark'] .order-intro h2 em { color:#d58b6b; }
  :root[data-theme='dark'] .order-eyebrow, :root[data-theme='dark'] .order-intro-note span { color:#c6a572; }
  @media(max-width:650px) {
    .order-intro { padding:26px 20px; align-items:flex-start; flex-direction:column; gap:20px; }
    .order-intro h2 { font-size:34px; }
    .project-exhibit[data-number='69'] .exhibit-toolbar { padding:12px 16px; gap:10px; }
    .project-exhibit[data-number='69'] .exhibit-story { top:10px; left:10px; padding:8px 10px; max-width:calc(100% - 20px); }
    .project-exhibit[data-number='69'] .exhibit-story-detail { display:none; }
    .project-exhibit[data-number='69'] .walkthrough-steps { flex-wrap:wrap; }
    .project-exhibit[data-number='69'] .walkthrough-steps button { flex:1 0 40%; }
  }

  .exhibit-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .project-exhibit .division-labels[hidden], .project-exhibit .division-key[hidden] { display: none !important; }
  .project-exhibit:is([data-number='74'], [data-number='75'], [data-number='76']) .exhibit-scene, .project-exhibit:is([data-number='74'], [data-number='75'], [data-number='76']) .exhibit-art { position: relative; }
  .division-labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .division-label { position: absolute; display: flex; gap: 8px; align-items: center; transform: translate(-50%, -50%); background: rgba(20, 24, 25, .92); color: #fff4df; border: 1px solid #c8a66b; border-radius: 7px; padding: 8px 10px; box-shadow: 0 3px 16px #0005; white-space: nowrap; }
  .division-number { display: inline-grid; place-items: center; flex: 0 0 22px; width: 22px; height: 22px; border: 1px solid #c8a66b; border-radius: 50%; color: #e3bd7b; font: 11px/1 var(--mono); }
  .division-copy strong, .division-key strong { display: block; font-size: 12px; font-weight: 600; }
  .division-copy small { display: block; margin-top: 3px; font-size: 10px; color: #e0d5c1; }
  .division-key { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; list-style: none; margin: 0; padding: 18px 22px; border-top: 1px solid var(--line); }
  .division-key li { display: flex; align-items: center; gap: 8px; }
  .division-key small { display: block; color: var(--muted); font-size: 10px; line-height: 1.5; margin-top: 3px; }
  .project-exhibit[data-number='74'] .division-key { grid-template-columns: repeat(3, 1fr); }
  /* Agrim's artwork and live city share the site's day/night presentation. */
  .project-exhibit[data-number='76'] {
    --city-label-bg: #fffaf0f5;
    --city-label-ink: #292b25;
    --city-label-muted: #5d584d;
    --city-label-gold: #806025;
    --city-label-border: #a88a50;
    --city-label-shadow: 0 3px 16px #3e301c24;
  }
