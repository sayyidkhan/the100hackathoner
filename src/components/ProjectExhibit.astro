---
import { getImage } from 'astro:assets';
import type { ProjectArt } from '../lib/project-art';
interface Props { number: number; title: string; art: ProjectArt; }
const { number, title, art } = Astro.props;
async function variants(src: ProjectArt['light']) {
  const images = await Promise.all([480, 800, 1200, 1536].map(width => getImage({ src, width, format: 'webp', quality: 80 })));
  return { src: images[2].src, srcset: images.map((image, i) => `${image.src} ${[480, 800, 1200, 1536][i]}w`).join(', ') };
}
const divisions = [
  { id: 'community', name: 'Community', purpose: 'Protect the people', x: 19, y: 47 },
  { id: 'academy', name: 'Builder Academy', purpose: 'Teach the builders', x: 50, y: 18 },
  { id: 'machines', name: 'Machine Systems', purpose: 'Keep the city running', x: 82, y: 35 },
  { id: 'mayor', name: 'Mayor Agrim', purpose: 'Lead & balance all three', x: 50, y: 73 },
];
const [light, dark] = await Promise.all([variants(art.light), variants(art.dark)]);
---
<section class="project-exhibit" data-project-exhibit data-number={number} data-model={art.model} aria-label={`${title} concept exhibit`}>
  <div class="exhibit-toolbar">
    <p>THE PROJECT, REIMAGINED</p>
    <div role="group" aria-label="Display mode" class="exhibit-modes">
      <button type="button" data-mode="artwork" aria-pressed="true">Artwork</button>
      <button type="button" data-mode="3d" aria-pressed="false">Explore in 3D</button>
    </div>
  </div>
  <figure>
    <div class="exhibit-art" data-art>
      <picture>
        <source data-dark-art media="(prefers-color-scheme: dark)" srcset={dark.srcset} sizes="(max-width: 920px) 100vw, 920px" type="image/webp" />
        <img src={light.src} srcset={light.srcset} sizes="(max-width: 920px) 100vw, 920px" width="1536" height="1024" alt={art.alt} loading="lazy" decoding="async" />
      </picture>
      {number === 76 && <div class="division-labels" aria-hidden="true">
        {divisions.map((division, index) => <div class="division-label" data-division={division.id} style={`left:${division.x}%;top:${division.y}%`}>
          <span class="division-number">{index + 1}</span>
          <span class="division-copy"><strong>{division.name}</strong><small>{division.purpose}</small></span>
        </div>)}
      </div>}
    </div>
    <div class="exhibit-scene" data-scene hidden>
      <canvas tabindex="0" aria-label={`Interactive 3D concept for ${title}. Drag or use arrow keys to rotate.`}></canvas>
      {number === 76 && <div class="division-labels" aria-hidden="true">
        {divisions.map((division, index) => <div class="division-label" data-division={division.id} style={`left:${division.x}%;top:${division.y}%`}>
          <span class="division-number">{index + 1}</span>
          <span class="division-copy"><strong>{division.name}</strong><small>{division.purpose}</small></span>
        </div>)}
      </div>}
      {(number === 55 || number === 58 || number === 59 || number === 82) && <div class="exhibit-story" data-story aria-live="off" hidden>
        <p class="exhibit-story-heading"><span class="exhibit-story-dot" aria-hidden="true"></span><span class="exhibit-story-step" data-story-step></span><span data-story-title></span></p>
        <p class="exhibit-story-detail" data-story-detail></p>
      </div>}
    </div>
    <div class="exhibit-controls" data-controls hidden>
      <span>Drag to rotate · Arrow keys to turn</span>
      <button type="button" data-reset>Reset view</button>
      <button type="button" data-pause aria-pressed="false">Pause motion</button>
    </div>
    {number === 82 && <div class="exhibit-walkthrough" data-walkthrough hidden>
      <div class="walkthrough-steps" role="group" aria-label="FitStake walkthrough steps">
        {['Challenge', 'Rewards', 'Card & cap', 'Compete', 'Settle'].map((label, index) => <button type="button" data-story-select={index} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span> {label}</button>)}
        <button type="button" data-story-auto aria-pressed="true">Auto-play steps</button>
      </div>
      <p>Sandbox demo · Simulated activity · Each reward purchase needs approval.</p>
    </div>}
    {number === 76 && <ol class="division-key" aria-label="City divisions and their purposes">
      {divisions.map((division, index) => <li><span class="division-number">{index + 1}</span><span><strong>{division.name}</strong><small>{division.purpose}</small></span></li>)}
    </ol>}
    <figcaption>{art.caption}<small>Concept artwork and a 3D interpretation of the project.</small></figcaption>
  </figure>
  <p class="exhibit-status" role="status" data-status></p>
</section>
<script is:inline type="module" src="/landing/project-exhibit.js"></script>
<style is:inline>
  .project-exhibit[data-number='76'] .exhibit-scene, .project-exhibit[data-number='76'] .exhibit-art { position: relative; }
  .division-labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .division-label { position: absolute; display: flex; gap: 8px; align-items: center; transform: translate(-50%, -50%); background: rgba(20, 24, 25, .92); color: #fff4df; border: 1px solid #c8a66b; border-radius: 7px; padding: 8px 10px; box-shadow: 0 3px 16px #0005; white-space: nowrap; }
  .division-number { display: inline-grid; place-items: center; flex: 0 0 22px; width: 22px; height: 22px; border: 1px solid #c8a66b; border-radius: 50%; color: #e3bd7b; font: 11px/1 var(--mono); }
  .division-copy strong, .division-key strong { display: block; font-size: 12px; font-weight: 600; }
  .division-copy small { display: block; margin-top: 3px; font-size: 10px; color: #e0d5c1; }
  .division-key { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; list-style: none; margin: 0; padding: 18px 22px; border-top: 1px solid var(--line); }
  .division-key li { display: flex; align-items: center; gap: 8px; }
  .division-key small { display: block; color: var(--muted); font-size: 10px; line-height: 1.5; margin-top: 3px; }
  @media (max-width: 650px) {
    .division-copy { display: none; }
    .division-label { padding: 4px; border-radius: 50%; }
    .division-key { grid-template-columns: repeat(2, 1fr); gap: 14px 10px; padding: 16px; }
  }
</style>
<style>
  .project-exhibit { margin-top: 48px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .exhibit-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; border-bottom: 1px solid var(--line); }
  .exhibit-toolbar p { margin: 0; font: 10px/1.5 var(--mono); letter-spacing: .08em; color: var(--muted); }
  .exhibit-modes { display: flex; flex-shrink: 0; gap: 4px; }
  button { cursor: pointer; border: 1px solid var(--line-strong); background: transparent; color: var(--ink); border-radius: 999px; font: inherit; font-size: .8rem; padding: 9px 14px; }
  button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  button:focus-visible, canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
  figure { margin: 0; }
  .exhibit-art, .exhibit-scene { aspect-ratio: 3 / 2; background: var(--bg); }
  /* A quiet phase caption stays attached to the interactive scene. */
  .exhibit-scene { position: relative; }
  .exhibit-story { --story-accent: #cb493f; position: absolute; top: 22px; left: 22px; max-width: calc(100% - 44px); pointer-events: none; color: var(--ink); text-shadow: 0 1px 8px var(--bg); }
  .exhibit-story[data-tone='thinking'] { --story-accent: #b48a38; }
  .exhibit-story[data-tone='flowing'] { --story-accent: #547eff; }
  .exhibit-story[data-tone='complete'] { --story-accent: #41977a; }
  .exhibit-story-heading { display: flex; align-items: center; gap: 8px; margin: 0; font-size: .9rem; font-weight: 500; line-height: 1.4; }
  .exhibit-story-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; background: var(--story-accent); box-shadow: 0 0 9px color-mix(in srgb, var(--story-accent) 35%, transparent); }
  .exhibit-story-step { color: var(--muted); font: .65rem/1 var(--mono); }
  .exhibit-story-detail { margin: 5px 0 0 14px; color: var(--muted); font-size: .7rem; line-height: 1.4; }
  img { display: block; width: 100%; height: auto; }
  canvas { display: block; width: 100%; height: 100%; }
  [hidden] { display: none !important; }
  .exhibit-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding: 12px 22px; border-top: 1px solid var(--line); }
  .exhibit-controls span { flex: 1; font-size: .75rem; color: var(--muted); }
  figcaption { padding: 22px; font-size: 1rem; line-height: 1.5; }
  figcaption small { display: block; margin-top: 8px; font-size: .75rem; color: var(--muted); }
  .exhibit-status { margin: 0; padding: 0 22px 16px; color: var(--muted); font-size: .8rem; }
  .exhibit-status:empty { display: none; }
  .exhibit-walkthrough { padding: 16px 22px; border-top: 1px solid var(--line); }
  .walkthrough-steps { display: flex; flex-wrap: nowrap; gap: 7px; overflow-x: auto; padding: 2px; }
  .walkthrough-steps button { flex: 1 0 auto; white-space: nowrap; }
  .walkthrough-steps span { font: .65rem var(--mono); margin-right: 5px; }
  .exhibit-walkthrough p { color: var(--muted); font-size: .75rem; line-height: 1.5; margin: 12px 0 0; }
  .project-exhibit[data-number='82'] .exhibit-story { right: 22px; max-width: 540px; }
  @media (max-width: 550px) { .exhibit-toolbar { align-items: flex-start; flex-direction: column; padding: 16px; } .exhibit-scene { aspect-ratio: 1; } .exhibit-story { top: 14px; left: 14px; max-width: calc(100% - 28px); } .exhibit-story-heading { gap: 6px; font-size: .78rem; } .exhibit-story-detail { margin-left: 12px; font-size: .65rem; } figcaption { padding: 16px; } .exhibit-controls span { flex-basis: 100%; } }
</style>
