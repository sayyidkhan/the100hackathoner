---
import { getImage } from 'astro:assets';
import type { ProjectArt } from '../lib/project-art';
interface Props { number: number; title: string; art: ProjectArt; }
const { number, title, art } = Astro.props;
async function variants(src: ProjectArt['light']) {
  const images = await Promise.all([480, 800, 1200, 1536].map(width => getImage({ src, width, format: 'webp', quality: 80 })));
  return { src: images[2].src, srcset: images.map((image, i) => `${image.src} ${[480, 800, 1200, 1536][i]}w`).join(', ') };
}
const [light, dark] = await Promise.all([variants(art.light), variants(art.dark)]);
---
<section class="project-exhibit" data-project-exhibit data-number={number} data-model={art.model} aria-label={`${title} concept exhibit`}>
  <div class="exhibit-toolbar">
    <p>THE PROJECT, REIMAGINED</p>
    <div role="group" aria-label="Display mode" class="exhibit-modes">
      <button type="button" data-mode="artwork" aria-pressed="true">Artwork</button>
      <button type="button" data-mode="3d" aria-pressed="false">Explore in 3D</button>
    </div>
  </div>
  <figure>
    <div class="exhibit-art" data-art>
      <picture>
        <source data-dark-art media="(prefers-color-scheme: dark)" srcset={dark.srcset} sizes="(max-width: 920px) 100vw, 920px" type="image/webp" />
        <img src={light.src} srcset={light.srcset} sizes="(max-width: 920px) 100vw, 920px" width="1536" height="1024" alt={art.alt} loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="exhibit-scene" data-scene hidden>
      <canvas tabindex="0" aria-label={`Interactive 3D concept for ${title}. Drag or use arrow keys to rotate.`}></canvas>
    </div>
    <div class="exhibit-controls" data-controls hidden>
      <span>Drag to rotate · Arrow keys to turn</span>
      <button type="button" data-reset>Reset view</button>
      <button type="button" data-pause aria-pressed="false">Pause motion</button>
    </div>
    <figcaption>{art.caption}<small>Concept artwork and a 3D interpretation of the project.</small></figcaption>
  </figure>
  <p class="exhibit-status" role="status" data-status></p>
</section>
<script is:inline type="module" src="/landing/project-exhibit.js"></script>
<style>
  .project-exhibit { margin-top: 48px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .exhibit-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; border-bottom: 1px solid var(--line); }
  .exhibit-toolbar p { margin: 0; font: 10px/1.5 var(--mono); letter-spacing: .08em; color: var(--muted); }
  .exhibit-modes { display: flex; flex-shrink: 0; gap: 4px; }
  button { cursor: pointer; border: 1px solid var(--line-strong); background: transparent; color: var(--ink); border-radius: 999px; font: inherit; font-size: .8rem; padding: 9px 14px; }
  button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  button:focus-visible, canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
  figure { margin: 0; }
  .exhibit-art, .exhibit-scene { aspect-ratio: 3 / 2; background: var(--bg); }
  img { display: block; width: 100%; height: auto; }
  canvas { display: block; width: 100%; height: 100%; }
  [hidden] { display: none !important; }
  .exhibit-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding: 12px 22px; border-top: 1px solid var(--line); }
  .exhibit-controls span { flex: 1; font-size: .75rem; color: var(--muted); }
  figcaption { padding: 22px; font-size: 1rem; line-height: 1.5; }
  figcaption small { display: block; margin-top: 8px; font-size: .75rem; color: var(--muted); }
  .exhibit-status { margin: 0; padding: 0 22px 16px; color: var(--muted); font-size: .8rem; }
  .exhibit-status:empty { display: none; }
  @media (max-width: 550px) { .exhibit-toolbar { align-items: flex-start; flex-direction: column; padding: 16px; } .exhibit-scene { aspect-ratio: 1; } figcaption { padding: 16px; } .exhibit-controls span { flex-basis: 100%; } }
</style>
