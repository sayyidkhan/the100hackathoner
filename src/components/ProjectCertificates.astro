---
import certificates from "../data/certificates.json";

interface Props {
  number: number;
}

const entries = certificates.filter((certificate) => certificate.hackathonNumber === Astro.props.number);
---

{entries.length > 0 && (
  <aside class="certificates" aria-label="Event certificates">
    {entries.map((certificate, index) => (
      <figure class="certificate-card">
        <figcaption>
          <p class="certificate-label">Certificate</p>
          <p class="certificate-title">{certificate.title.replace(/^Certificate of /i, "")}</p>
        </figcaption>
        <button class="certificate-paper" type="button" data-open-certificate aria-label={`View ${certificate.title} full screen`} aria-haspopup="dialog" aria-controls={`certificate-viewer-${Astro.props.number}-${index}`}>
          <img src={certificate.image} alt={certificate.alt} width={certificate.width} height={certificate.height} loading="lazy" decoding="async" />
        </button>
        <button class="certificate-open" type="button" data-open-certificate aria-haspopup="dialog" aria-controls={`certificate-viewer-${Astro.props.number}-${index}`}>
          View certificate <span aria-hidden="true">↗</span>
        </button>
        <dialog class="certificate-viewer" id={`certificate-viewer-${Astro.props.number}-${index}`} aria-labelledby={`certificate-viewer-title-${Astro.props.number}-${index}`}>
          <div class="viewer-header">
            <h2 id={`certificate-viewer-title-${Astro.props.number}-${index}`}>{certificate.title}</h2>
            <form method="dialog"><button class="viewer-close" autofocus aria-label="Close certificate">Close <span aria-hidden="true">×</span></button></form>
          </div>
          <div class="viewer-toolbar" role="group" aria-label="Certificate zoom controls">
            <button type="button" data-zoom-out aria-label="Zoom out">−</button>
            <output class="zoom-level" aria-live="polite" aria-label="Zoom level">100%</output>
            <button type="button" data-zoom-in aria-label="Zoom in">+</button>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <button type="button" class="zoom-reset" data-zoom-reset>Reset</button>
          </div>
          <div class="viewer-image" tabindex="0" role="region" aria-label="Certificate image. Use plus and minus to zoom, arrow keys to move, and zero to reset.">
            <img src={certificate.image} alt={certificate.alt} width={certificate.width} height={certificate.height} loading="lazy" decoding="async" draggable="false" />
          </div>
          <p class="viewer-hint"><span class="desktop-hint">Scroll to zoom · Drag to move</span><span class="touch-hint">Pinch to zoom · Drag to move</span></p>
        </dialog>
      </figure>
    ))}
  </aside>
)}

<style>
  .certificates { display: grid; gap: 16px; min-width: 0; }
  .certificate-card { margin: 0; padding: 20px; background: var(--bg-paper); border: 1px solid var(--line); border-radius: 12px; }
  .certificate-label { margin: 0; color: var(--muted); font-family: var(--body); font-size: var(--detail-label-size, .72rem); font-weight: 500; line-height: 1.5; letter-spacing: .08em; text-transform: uppercase; }
  .certificate-title { margin: 6px 0 18px; color: var(--ink); font-size: var(--detail-value-size, 1.1rem); font-weight: 500; line-height: 1.5; }
  .certificate-paper { display: block; width: 100%; padding: 6px; background: #fff; border: 1px solid var(--line); box-shadow: 0 3px 10px #00000008; cursor: zoom-in; }
  img { display: block; width: 100%; height: auto; }
  .certificate-open { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 44px; margin-top: 12px; padding: 8px 0 0; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: .85rem; cursor: pointer; }
  .certificate-open:hover { color: var(--red); }
  button:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
  .certificate-viewer { position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #141416; color: #fff; }
  .certificate-viewer[open] { display: flex; flex-direction: column; }
  .viewer-header { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 20px; padding: 12px 24px; border-bottom: 1px solid #ffffff26; }
  .viewer-header h2 { margin: 0; font-size: 1rem; font-weight: 500; line-height: 1.4; }
  .viewer-header form { margin: 0; }
  .viewer-close { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 14px; border: 1px solid #ffffff40; border-radius: 6px; background: transparent; color: #fff; font: inherit; font-size: .85rem; cursor: pointer; }
  .viewer-close span { font-size: 1.5rem; }
  .viewer-close:hover { background: #ffffff1a; }
  .viewer-toolbar { display: flex; flex-shrink: 0; align-items: center; justify-content: center; gap: 4px; padding: 8px 16px; }
  .viewer-toolbar button { display: grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0 12px; border: 1px solid #ffffff26; border-radius: 6px; background: #ffffff08; color: #fff; font: inherit; font-size: 1.3rem; cursor: pointer; }
  .viewer-toolbar button:hover:not(:disabled) { background: #ffffff1a; }
  .viewer-toolbar button:disabled { opacity: .35; cursor: default; }
  .viewer-toolbar .zoom-reset { font-size: .85rem; }
  .zoom-level { min-width: 66px; text-align: center; font-size: .85rem; font-variant-numeric: tabular-nums; }
  .toolbar-divider { width: 1px; height: 24px; margin: 0 8px; background: #ffffff26; }
  .viewer-image { position: relative; flex: 1; min-height: 0; overflow: hidden; touch-action: none; user-select: none; }
  .viewer-image:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  .viewer-image[data-zoomed="true"] { cursor: grab; }
  .viewer-image[data-dragging="true"] { cursor: grabbing; }
  .viewer-image img { position: absolute; top: 50%; left: 50%; max-width: none; transform-origin: center; will-change: transform; pointer-events: none; }
  .viewer-hint { flex-shrink: 0; margin: 0; padding: 12px 16px 16px; color: #b9b9bd; text-align: center; font-size: .75rem; }
  .touch-hint { display: none; }
  @media (pointer: coarse) { .desktop-hint { display: none; } .touch-hint { display: inline; } }
  :global(html:has(.certificate-viewer[open])) { overflow: hidden; }
  @media (max-width: 640px) { .viewer-header { padding: 12px 16px; gap: 12px; } .viewer-header h2 { font-size: .85rem; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.certificate-card').forEach((card) => {
    const dialog = card.querySelector<HTMLDialogElement>('.certificate-viewer');
    const stage = card.querySelector<HTMLElement>('.viewer-image');
    const image = stage?.querySelector<HTMLImageElement>('img');
    const zoomIn = card.querySelector<HTMLButtonElement>('[data-zoom-in]');
    const zoomOut = card.querySelector<HTMLButtonElement>('[data-zoom-out]');
    const reset = card.querySelector<HTMLButtonElement>('[data-zoom-reset]');
    const level = card.querySelector<HTMLOutputElement>('.zoom-level');
    if (!dialog || !stage || !image || !zoomIn || !zoomOut || !reset || !level) return;

    let zoom = 1;
    let panX = 0;
    let panY = 0;
    let fittedWidth = 0;
    let fittedHeight = 0;
    const minZoom = 1;
    const maxZoom = 5;
    const pointers = new Map<number, { x: number; y: number }>();
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    function render() {
      const availableWidth = Math.max(1, stage!.clientWidth - 32);
      const availableHeight = Math.max(1, stage!.clientHeight - 32);
      const imageWidth = Number(image!.getAttribute('width'));
      const imageHeight = Number(image!.getAttribute('height'));
      const fit = Math.min(availableWidth / imageWidth, availableHeight / imageHeight);
      fittedWidth = imageWidth * fit;
      fittedHeight = imageHeight * fit;
      const maxX = Math.max(0, (fittedWidth * zoom - availableWidth) / 2);
      const maxY = Math.max(0, (fittedHeight * zoom - availableHeight) / 2);
      panX = clamp(panX, -maxX, maxX);
      panY = clamp(panY, -maxY, maxY);
      image!.style.width = `${fittedWidth}px`;
      image!.style.height = `${fittedHeight}px`;
      image!.style.transform = `translate(-50%, -50%) translate(${panX}px, ${panY}px) scale(${zoom})`;
      stage!.dataset.zoomed = String(zoom > minZoom);
      const percentage = `${Math.round(zoom * 100)}%`;
      if (level!.value !== percentage) level!.value = percentage;
      zoomOut!.disabled = zoom <= minZoom;
      zoomIn!.disabled = zoom >= maxZoom;
      reset!.disabled = zoom === minZoom && panX === 0 && panY === 0;
    }

    function resetView() {
      zoom = minZoom;
      panX = panY = 0;
      render();
    }

    function setZoom(next: number, clientX?: number, clientY?: number) {
      const rect = stage!.getBoundingClientRect();
      const focalX = clientX === undefined ? 0 : clientX - rect.left - rect.width / 2;
      const focalY = clientY === undefined ? 0 : clientY - rect.top - rect.height / 2;
      const bounded = clamp(next, minZoom, maxZoom);
      const ratio = bounded / zoom;
      panX = focalX - (focalX - panX) * ratio;
      panY = focalY - (focalY - panY) * ratio;
      zoom = bounded;
      render();
    }

    zoomIn.addEventListener('click', () => setZoom(zoom + .25));
    zoomOut.addEventListener('click', () => setZoom(zoom - .25));
    reset.addEventListener('click', resetView);
    stage.addEventListener('wheel', (event) => {
      event.preventDefault();
      const delta = event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? stage.clientHeight : 1);
      setZoom(zoom * Math.exp(-delta * .002), event.clientX, event.clientY);
    }, { passive: false });

    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      stage.setPointerCapture(event.pointerId);
      stage.dataset.dragging = String(zoom > minZoom);
    });
    stage.addEventListener('pointermove', (event) => {
      const previous = pointers.get(event.pointerId);
      if (!previous) return;
      const before = [...pointers.values()];
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size >= 2) {
        const after = [...pointers.values()];
        const distance = (points: typeof before) => Math.hypot(points[1].x - points[0].x, points[1].y - points[0].y);
        const oldDistance = distance(before);
        const oldX = (before[0].x + before[1].x) / 2;
        const oldY = (before[0].y + before[1].y) / 2;
        if (oldDistance > 0) setZoom(zoom * distance(after) / oldDistance, oldX, oldY);
        panX += (after[0].x + after[1].x) / 2 - oldX;
        panY += (after[0].y + after[1].y) / 2 - oldY;
      } else {
        panX += event.clientX - previous.x;
        panY += event.clientY - previous.y;
      }
      stage.dataset.dragging = String(zoom > minZoom);
      render();
    });
    const endPointer = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      stage.dataset.dragging = String(pointers.size > 0 && zoom > minZoom);
    };
    stage.addEventListener('pointerup', endPointer);
    stage.addEventListener('pointercancel', endPointer);
    stage.addEventListener('lostpointercapture', endPointer);
    stage.addEventListener('keydown', (event) => {
      if (event.key === '+' || event.key === '=') setZoom(zoom + .25);
      else if (event.key === '-') setZoom(zoom - .25);
      else if (event.key === '0') resetView();
      else if (event.key === 'ArrowLeft') panX += 40;
      else if (event.key === 'ArrowRight') panX -= 40;
      else if (event.key === 'ArrowUp') panY += 40;
      else if (event.key === 'ArrowDown') panY -= 40;
      else return;
      event.preventDefault();
      render();
    });
    new ResizeObserver(() => { if (dialog.open) render(); }).observe(stage);
    dialog.addEventListener('close', () => {
      pointers.clear();
      stage.dataset.dragging = 'false';
    });
    card.querySelectorAll<HTMLButtonElement>('[data-open-certificate]').forEach((button) => {
      button.addEventListener('click', () => {
        dialog.showModal();
        resetView();
      });
    });
  });
</script>
