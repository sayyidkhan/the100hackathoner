---
import BookJourneyPage from "./BookJourneyPage.astro";
---
<section id="book" class="book-premiere wrap" aria-labelledby="book-heading">
  <header class="book-header">
    <p class="eyebrow">02 / BEYOND THE NUMBER</p>
  </header>

  <div class="book-layout">
    <figure class="book-exhibit">
      <div class="book-object" role="img" aria-label="The 100 Hackathoner: an animated journey from the first hackathon through trials, growth and carrying lessons into the founder chapter.">
        <div class="book-inner page-face" aria-hidden="true"><BookJourneyPage page={3} /></div>
        <div class="book-leaf" aria-hidden="true">
          <div class="leaf-front page-face"><BookJourneyPage page={1} /></div>
          <div class="leaf-back page-face"><BookJourneyPage page={2} /></div>
        </div>
        <div class="book-paper" aria-hidden="true"></div>
        <div class="book-ribbon" aria-hidden="true"></div>
        <div class="book-lid">
          <div class="inside-cover page-face" aria-hidden="true"><BookJourneyPage page={0} /></div>
        <div class="book-cover">
          <span class="cover-edition"><span class="memoir-copy">A LIFE IN PROTOTYPES</span><span class="principles-copy">PRINCIPLES FROM THE FIELD</span></span>
          <div class="cover-memoir">
            <span class="cover-title">THE <strong>100</strong> HACKATHONER</span>
            <span class="cover-rule" aria-hidden="true"></span>
            <span class="cover-subtitle">The things we build.<br />The people we become.</span>
          </div>
          <div class="cover-forward">
            <span class="forward-title">The Forward<br />Deployed<br /><em>Hackathoner.</em></span>
            <span class="forward-symbol" aria-hidden="true">↗</span>
            <span class="cover-subtitle">Build. Learn. Own.<br />Make the work compound.</span>
          </div>
          <span class="cover-author">SAYYID KHAN</span>
        </div>
        </div>
      </div>
    </figure>

    <div class="book-story">
      <p class="story-kicker"><span class="memoir-copy">THE JOURNEY, BEYOND THE PROJECTS</span><span class="principles-copy">THE PRINCIPLES, BEHIND THE PRACTICE</span></p>
      <h2 id="book-heading"><span class="memoir-copy">A hundred hackathons.<br /><em>More stories to tell.</em></span><span class="principles-copy">Build with intent.<br /><em>Make it matter.</em></span></h2>
      <p class="book-intro"><span class="memoir-copy">What stays with you after the demo is over?</span><span class="principles-copy">What turns repeated building into better judgement?</span></p>
      <p class="book-description"><span class="memoir-copy">From my first hackathon in 2016 to the pursuit of 100: the teams, wrong turns and turning points that are changing me from engineer to founder. A story about what I built, what it taught me, and who I’m becoming.</span><span class="principles-copy">The principles I’m taking from the field: ship to learn, build range through repetition, own the outcome, and leave something that compounds. A practical book about moving from builder to operator.</span></p>

      <fieldset class="book-options">
        <legend>EXPLORE THE WORKING TITLES</legend>
        <label>
          <input type="radio" name="book-concept" value="memoir" checked />
          <span class="choice-number">01</span>
          <span class="choice-copy"><strong>The 100 Hackathoner</strong><small>The memoir · stories from the field</small></span>
          <span class="choice-mark" aria-hidden="true">↗</span>
        </label>
        <label>
          <input type="radio" name="book-concept" value="forward" />
          <span class="choice-number">02</span>
          <span class="choice-copy"><strong>The Forward Deployed Hackathoner</strong><small>The principles · builder to operator</small></span>
          <span class="choice-mark" aria-hidden="true">↗</span>
        </label>
      </fieldset>

      <a class="book-cta" href="/waitlist/">Join the book waitlist <span aria-hidden="true">↗</span></a>
      <p class="book-fineprint">Occasional updates. No release date yet.</p>
    </div>
  </div>


</section>

<style>
  .book-premiere { max-width:1280px; padding-block:80px; border-top:1px solid var(--line); scroll-margin-top:24px; }
  .book-header { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:42px; }
  .book-layout { display:grid; grid-template-columns:minmax(0,.95fr) minmax(0,1fr); gap:clamp(32px,5vw,80px); align-items:center; }
  .book-exhibit { margin:0; position:relative; display:flex; flex-direction:column; align-items:center; padding:28px 30px 22px; background:radial-gradient(ellipse at 50% 45%,var(--raised),var(--soft)); border:1px solid var(--line); overflow:hidden; perspective:1400px; }
  .book-object { position:relative; width:min(76%,300px); height:auto; min-height:0; aspect-ratio: .69; flex:none; margin:34px 0 42px; transform:rotateY(-13deg) rotateZ(-6deg); transform-style:preserve-3d; --spread-scale:.78; --book-duration:28s; }
  .book-paper { position:absolute; inset:6px -10px -5px 9px; border:1px solid #b9ad99; border-radius:3px 8px 8px 3px; background:repeating-linear-gradient(0deg,#e7dfcd 0 1px,#faf5e9 1px 3px); box-shadow:15px 24px 28px #0003; }
  .book-ribbon { position:absolute; bottom:-28px; left:55%; width:22px; height:60px; background:#bf2731; clip-path:polygon(0 0,100% 0,100% 100%,50% 84%,0 100%); }
  .book-cover { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:9% 10% 9% 13%; border-radius:3px 5px 5px 3px; color:#f5eedf; border:1px solid #464344; border-left:9px solid #bd2530; background:linear-gradient(90deg,#08090b 0%,#373436 3%,#19191b 8%,#222225 97%,#303032); box-shadow:inset 0 0 0 1px #ffffff0b; }
  .book-cover::after { content:""; position:absolute; inset:0; pointer-events:none; opacity:.18; background:repeating-linear-gradient(0deg,transparent 0 2px,#ffffff18 2px 3px),repeating-linear-gradient(90deg,transparent 0 2px,#0004 2px 3px); }
  .cover-edition { font:8px/1.5 var(--mono); letter-spacing:.16em; color:#cec4b3; }
  .cover-title { display:block; font:12px/1.4 var(--body); letter-spacing:.17em; }
  .cover-title strong { display:block; font:400 clamp(88px,10vw,148px)/1 var(--body); letter-spacing:-.09em; color:#f84e54; margin:10px 0 14px -5px; }
  .cover-rule { display:block; height:1px; background:#f84e54; width:40px; margin:24px 0 16px; }
  .cover-subtitle { display:block; font:italic 14px/1.5 Georgia,serif; color:#e4dcca; }
  .cover-author { font:9px/1.5 var(--body); letter-spacing:.2em; }
  .cover-forward { display:none; }
  .forward-title { display:block; font:26px/1.15 Georgia,serif; letter-spacing:-.03em; }
  .forward-title em { color:#f84e54; }
  .forward-symbol { display:block; color:#f84e54; font:90px/1.2 var(--body); }
  .book-premiere:has(input[value="forward"]:checked) .cover-memoir { display:none; }
  .book-premiere:has(input[value="forward"]:checked) .cover-forward { display:block; }
  .story-kicker { color:var(--muted); font:10px/1.6 var(--mono); letter-spacing:.09em; margin-bottom:20px; }
  .book-story h2 { font:400 clamp(36px,3.8vw,54px)/1.1 var(--body); letter-spacing:-.055em; }
  .book-story h2 em { display:block; color:var(--accent); font-family:Georgia,serif; font-weight:400; letter-spacing:-.045em; margin-top:8px; }
  .book-intro { font:500 18px/1.5 var(--body); margin:26px 0 10px; }
  .book-description { color:var(--muted); font:16px/1.75 var(--body); max-width:510px; }
  .book-options { border:0; padding:0; margin:28px 0; min-width:0; }
  .book-options legend { font:9px/1.5 var(--mono); letter-spacing:.08em; color:var(--muted); margin-bottom:10px; }
  .book-options label { position:relative; display:flex; gap:14px; align-items:center; cursor:pointer; padding:14px 10px; border-top:1px solid var(--line); color:var(--muted); }
  .book-options label:last-child { border-bottom:1px solid var(--line); }
  .book-options label:has(input:checked) { background:var(--soft); color:var(--ink); }
  .book-options input { position:absolute; width:1px; height:1px; clip-path:inset(50%); overflow:hidden; }
  .book-options label:has(input:focus-visible) { outline:2px solid var(--accent); outline-offset:3px; }
  .choice-number { font:11px var(--mono); }
  .choice-copy { flex:1; min-width:0; }
  .choice-copy strong { display:block; font:500 15px/1.4 var(--body); }
  .choice-copy small { display:block; color:var(--muted); font:11px/1.5 var(--body); margin-top:4px; }
  .choice-mark { font-size:20px; opacity:0; }
  label:has(input:checked) .choice-mark { opacity:1; color:var(--accent); }
  .book-cta { display:inline-flex; align-items:center; justify-content:space-between; gap:38px; min-height:50px; padding:13px 24px; border-radius:999px; background:var(--accent); color:var(--on-accent); text-decoration:none; font:500 15px/1.5 var(--body); }
  .book-cta:hover { box-shadow:0 0 0 4px var(--soft); }
  .book-cta span { font-size:22px; }
  .book-fineprint { font:11px/1.5 var(--body); color:var(--muted); margin-top:10px; }
  @media(max-width:1000px) {
    .book-layout { gap:30px; }
    .book-exhibit { padding-inline:20px; }
    .book-object { width:84%; }
    .forward-title { font-size:22px; }
    .cover-subtitle { font-size:12px; }
    .book-story h2 { font-size:38px; }
  }
  @media(max-width:760px) {
    .book-premiere { padding-block:48px; }
    .book-header { align-items:flex-start; gap:12px; margin-bottom:26px; }
    .book-header .eyebrow { font-size:10px; }
    .book-layout { grid-template-columns:1fr; gap:32px; }
    .book-exhibit { padding:22px 24px 18px; }
    .book-object { width:min(76%,280px); max-width:78%; margin-block:24px 36px; --spread-scale:.72; }
    .cover-title strong { font-size:102px; }
    .cover-title { font-size:10px; }
    .cover-rule { margin:16px 0 10px; }
    .cover-edition { font-size:7px; }
    .cover-author { font-size:8px; }
    .forward-title { font-size:23px; }
    .forward-symbol { font-size:68px; }
    .book-story h2 { font-size:clamp(32px,7vw,44px); }
    .story-kicker { margin-bottom:14px; }
    .book-intro { margin-top:20px; font-size:17px; }
    .book-description { font-size:15px; }
    .book-options { margin-block:24px; }
  }

  .book-paper { transform:translateZ(-3px); }
  .book-ribbon { transform:translateZ(-2px); }
  .book-lid, .book-leaf { position:absolute; inset:0; transform-origin:0 50%; transform-style:preserve-3d; }
  .book-lid { transform:translateZ(4px); }
  .book-leaf { transform:translateZ(2px); }
  .book-cover { backface-visibility:hidden; transform:translateZ(1px); }
  .page-face { position:absolute; inset:0; overflow:hidden; display:flex; flex-direction:column; padding:10% 9% 8% 12%; border-radius:2px 5px 5px 2px; color:#302b25; background:linear-gradient(90deg,#cfc3ac,#f6efdf 9%,#fff8e9 70%,#eee3ce); border:1px solid #d6c8ad; backface-visibility:hidden; }
  .book-inner { transform:translateZ(0); }
  .leaf-front { transform:translateZ(.5px); }
  .leaf-back, .inside-cover { transform:rotateY(180deg) translateZ(.5px); background:linear-gradient(270deg,#cfc3ac,#f6efdf 9%,#fff8e9 70%,#eee3ce); }
  .inside-cover { border:7px solid #262326; border-right:9px solid #a5232c; }
  .book-exhibit.is-animated .book-object { animation:book-reframe var(--book-duration) ease-in-out infinite both; }
  .book-exhibit.is-animated .book-lid { animation:book-open var(--book-duration) cubic-bezier(.45,0,.25,1) infinite both; }
  .book-exhibit.is-animated .book-leaf { animation:book-turn var(--book-duration) cubic-bezier(.45,0,.25,1) infinite both; }
  .book-exhibit[data-running="false"] :global(*) { animation-play-state:paused !important; }
  @keyframes book-reframe {
    0%,12%,96%,100% { transform:translateX(0) rotateY(-13deg) rotateZ(-6deg) scale(1); }
    25%,82% { transform:translateX(calc(var(--spread-scale) * 50%)) rotateY(-5deg) rotateZ(-1deg) scale(var(--spread-scale)); }
  }
  @keyframes book-open {
    0%,14%,96%,100% { transform:translateZ(4px) rotateY(0deg); }
    27%,82% { transform:translateZ(4px) rotateY(-173deg); }
  }
  @keyframes book-turn {
    0%,43%,84%,100% { transform:translateZ(2px) rotateY(0deg); }
    55%,71% { transform:translateZ(2px) rotateY(-170deg); }
  }
  .principles-copy { display:none; }
  .book-premiere:has(input[value="forward"]:checked) .memoir-copy { display:none; }
  .book-premiere:has(input[value="forward"]:checked) .principles-copy { display:inline; }
  .book-premiere:has(input[value="forward"]:checked) .book-object { --book-duration:22s; }
  .book-premiere:has(input[value="forward"]:checked) .book-cover { border-left-color:#c79850; }
  .book-premiere:has(input[value="forward"]:checked) .forward-title em,
  .book-premiere:has(input[value="forward"]:checked) .forward-symbol { color:#e8b867; }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#book');
  const exhibit = section?.querySelector<HTMLElement>('.book-exhibit');
  if (section && exhibit) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    const syncMotion = () => {
      exhibit.dataset.running = String(inView && !document.hidden && !reducedMotion.matches);
    };
    exhibit.classList.add('is-animated');
    syncMotion();
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncMotion();
    }, { threshold: .15 });
    observer.observe(exhibit);
    document.addEventListener('visibilitychange', syncMotion);
    reducedMotion.addEventListener('change', syncMotion);
    section.querySelectorAll('input[name="book-concept"]').forEach(input => {
      input.addEventListener('change', () => {
        const isPrinciples = (input as HTMLInputElement).value === 'forward';
        exhibit.querySelector('.book-object')?.setAttribute('aria-label', isPrinciples
          ? 'The Forward Deployed Hackathoner: animated principles showing prototype feedback, repetition, useful outcomes and compounding assets.'
          : 'The 100 Hackathoner: an animated journey from the first hackathon through trials, growth and carrying lessons into the founder chapter.');
        exhibit.classList.remove('is-animated');
        void exhibit.offsetWidth;
        exhibit.classList.add('is-animated');
        syncMotion();
      });
    });
  }
</script>
