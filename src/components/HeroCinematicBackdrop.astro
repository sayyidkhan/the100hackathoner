<div class="cinematic-backdrop" data-cinematic-backdrop aria-hidden="true">
  <canvas data-cinematic-canvas></canvas>

  <span class="cinematic-flare cinematic-flare-blue"></span>
  <span class="cinematic-flare cinematic-flare-red"></span>
  <span class="cinematic-beam"></span>

  <div class="cinematic-number">
    <span>100</span>
    <small>Hackathons / One journey</small>
  </div>

  <div class="cinematic-coordinates">
    <span>01.3521° N</span>
    <i></i>
    <span>103.8198° E</span>
    <strong>SG / 073</strong>
  </div>

  <div class="cinematic-loop">
    <span>Idea</span><i></i>
    <span>Build</span><i></i>
    <span>Ship</span><i></i>
    <span>Learn</span><i></i>
    <strong>Repeat</strong>
  </div>

  <span class="cinematic-vignette"></span>
  <span class="cinematic-grain"></span>
</div>

<style>
  .cinematic-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 74% 46%, rgba(16, 48, 68, 0.7), transparent 34%),
      radial-gradient(circle at 35% 80%, rgba(76, 13, 22, 0.34), transparent 38%),
      linear-gradient(118deg, #05070b 0%, #070c13 43%, #08141b 72%, #06100f 100%);
    pointer-events: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.98;
  }

  .cinematic-flare {
    position: absolute;
    border-radius: 50%;
    filter: blur(8px);
    mix-blend-mode: screen;
    opacity: 0.38;
    will-change: transform;
  }

  .cinematic-flare-blue {
    top: -26%;
    right: 4%;
    width: clamp(360px, 48vw, 860px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(22, 116, 255, 0.34), transparent 67%);
  }

  .cinematic-flare-red {
    bottom: -42%;
    left: 20%;
    width: clamp(340px, 44vw, 780px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(237, 28, 36, 0.24), transparent 68%);
  }

  .cinematic-beam {
    position: absolute;
    top: -40%;
    left: 58%;
    width: 18%;
    height: 180%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(115, 207, 255, 0.05),
      rgba(115, 207, 255, 0.16),
      transparent
    );
    filter: blur(18px);
    opacity: 0.55;
    transform: rotate(17deg);
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .cinematic-number {
    position: absolute;
    top: -0.18em;
    right: clamp(-18px, 1.5vw, 34px);
    display: grid;
    justify-items: end;
    color: transparent;
    font-size: clamp(17rem, 31vw, 35rem);
    font-weight: 950;
    letter-spacing: -0.14em;
    line-height: 0.78;
    opacity: 0.23;
    transform: rotate(-6deg);
    transform-origin: 72% 42%;
    user-select: none;
    -webkit-text-stroke: 1px rgba(159, 218, 255, 0.48);
    will-change: transform;
  }

  .cinematic-number small {
    margin-top: 0.3em;
    margin-right: 0.15em;
    color: rgba(217, 239, 249, 0.66);
    font-size: 0.025em;
    font-weight: 800;
    letter-spacing: 0.24em;
    line-height: 1;
    text-transform: uppercase;
    -webkit-text-stroke: 0;
  }

  .cinematic-coordinates {
    position: absolute;
    top: 28px;
    left: 48px;
    display: flex;
    gap: 10px;
    align-items: center;
    color: rgba(218, 234, 240, 0.48);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cinematic-coordinates i {
    width: 38px;
    height: 1px;
    background: rgba(218, 234, 240, 0.32);
  }

  .cinematic-coordinates strong {
    color: #ff4248;
    font-weight: 900;
  }

  .cinematic-loop {
    position: absolute;
    right: 48px;
    bottom: 24px;
    left: 48px;
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    color: rgba(218, 234, 240, 0.44);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cinematic-loop i {
    width: clamp(22px, 4vw, 72px);
    height: 1px;
    background: linear-gradient(90deg, rgba(218, 234, 240, 0.08), rgba(218, 234, 240, 0.48));
  }

  .cinematic-loop strong {
    color: #ff4248;
  }

  .cinematic-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(2, 4, 7, 0.48), transparent 35% 74%, rgba(2, 4, 7, 0.25)),
      radial-gradient(ellipse at center, transparent 45%, rgba(2, 4, 7, 0.55) 115%);
  }

  .cinematic-grain {
    position: absolute;
    inset: -40%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
    opacity: 0.11;
    will-change: transform;
  }

  @keyframes cinematic-number-drift {
    0% {
      transform: translate3d(0, 0, 0) rotate(-6deg) scale(1);
    }

    50% {
      transform: translate3d(-1.4%, 2%, 0) rotate(-3deg) scale(1.025);
    }

    100% {
      transform: translate3d(1%, -1.2%, 0) rotate(-8deg) scale(0.99);
    }
  }

  @keyframes cinematic-flare-drift {
    from {
      transform: translate3d(-5%, -4%, 0) scale(0.94);
    }

    to {
      transform: translate3d(10%, 8%, 0) scale(1.12);
    }
  }

  @keyframes cinematic-flare-drift-reverse {
    from {
      transform: translate3d(8%, 7%, 0) scale(1.08);
    }

    to {
      transform: translate3d(-10%, -6%, 0) scale(0.94);
    }
  }

  @keyframes cinematic-beam-sweep {
    0%,
    12% {
      transform: translate3d(-42vw, 0, 0) rotate(17deg);
      opacity: 0;
    }

    28% {
      opacity: 0.7;
    }

    72%,
    100% {
      transform: translate3d(44vw, 0, 0) rotate(17deg);
      opacity: 0;
    }
  }

  @keyframes cinematic-grain-shift {
    0% {
      transform: translate3d(-2%, -3%, 0);
    }

    25% {
      transform: translate3d(3%, 1%, 0);
    }

    50% {
      transform: translate3d(-1%, 4%, 0);
    }

    75% {
      transform: translate3d(4%, -2%, 0);
    }

    100% {
      transform: translate3d(-3%, 2%, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cinematic-number {
      animation: cinematic-number-drift 20s ease-in-out infinite alternate;
    }

    .cinematic-flare-blue {
      animation: cinematic-flare-drift 17s ease-in-out infinite alternate;
    }

    .cinematic-flare-red {
      animation: cinematic-flare-drift-reverse 14s ease-in-out infinite alternate;
    }

    .cinematic-beam {
      animation: cinematic-beam-sweep 12s cubic-bezier(0.42, 0, 0.23, 1) infinite;
    }

    .cinematic-grain {
      animation: cinematic-grain-shift 240ms steps(2, end) infinite;
    }
  }

  @media (max-width: 720px) {
    .cinematic-number {
      top: 0.05em;
      right: -0.24em;
      font-size: 17rem;
      opacity: 0.18;
    }

    .cinematic-coordinates {
      top: 18px;
      left: 15px;
    }

    .cinematic-loop {
      display: none;
    }

    .cinematic-beam {
      left: 46%;
      width: 28%;
    }
  }
</style>

<script>
  type JourneyNode = {
    x: number;
    y: number;
    z: number;
    phase: number;
    speed: number;
    radius: number;
    index: number;
  };

  type ProjectedNode = JourneyNode & {
    px: number;
    py: number;
    scale: number;
  };

  const initializeBackdrop = (backdrop: HTMLElement) => {
    if (backdrop.dataset.ready === "true") return;
    backdrop.dataset.ready = "true";

    const canvas = backdrop.querySelector<HTMLCanvasElement>("[data-cinematic-canvas]");
    const hero = backdrop.closest<HTMLElement>(".hero");
    if (!canvas || !hero) return;

    const context = canvas.getContext("2d", { alpha: true });
    if (!context) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let animationFrame = 0;
    let sceneVisible = true;
    let startTime = performance.now();
    let pointerX = 0;
    let pointerY = 0;
    let pointerTargetX = 0;
    let pointerTargetY = 0;

    const seededRandom = (() => {
      let seed = 100073;
      return () => {
        seed += 0x6d2b79f5;
        let value = seed;
        value = Math.imul(value ^ (value >>> 15), value | 1);
        value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
        return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
      };
    })();

    const nodes: JourneyNode[] = Array.from({ length: 100 }, (_, index) => {
      const progress = index / 99;
      const angle = -Math.PI / 2 + index * 0.47;
      const radius = 0.035 + progress * 0.49;
      const jitter = (seededRandom() - 0.5) * 0.052;

      return {
        x: 0.7 + Math.cos(angle) * (radius + jitter),
        y: 0.49 + Math.sin(angle) * (radius + jitter) * 0.72,
        z: 0.25 + seededRandom() * 0.75,
        phase: seededRandom() * Math.PI * 2,
        speed: 0.55 + seededRandom() * 0.9,
        radius: 0.8 + seededRandom() * 1.8,
        index,
      };
    });

    const currentNode = nodes[72];
    currentNode.x = 0.79;
    currentNode.y = 0.31;
    currentNode.z = 1;
    currentNode.radius = 3.2;

    const resize = () => {
      const bounds = hero.getBoundingClientRect();
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      draw(performance.now());
    };

    const projectNodes = (time: number, reveal: number): ProjectedNode[] => {
      pointerX += (pointerTargetX - pointerX) * 0.035;
      pointerY += (pointerTargetY - pointerY) * 0.035;

      const cameraDriftX = Math.sin(time * 0.00011) * 10;
      const cameraDriftY = Math.cos(time * 0.00009) * 7;

      return nodes.map((node) => {
        const depth = 0.72 + node.z * 0.42;
        const floatX = Math.cos(time * 0.00022 * node.speed + node.phase) * 7 * node.z;
        const floatY = Math.sin(time * 0.00018 * node.speed + node.phase) * 6 * node.z;
        const targetX =
          (node.x - 0.5) * width * depth +
          width * 0.5 +
          floatX +
          cameraDriftX * node.z +
          pointerX * 34 * node.z;
        const targetY =
          (node.y - 0.5) * height * depth +
          height * 0.5 +
          floatY +
          cameraDriftY * node.z +
          pointerY * 24 * node.z;

        return {
          ...node,
          px: width * 0.68 + (targetX - width * 0.68) * reveal,
          py: height * 0.46 + (targetY - height * 0.46) * reveal,
          scale: depth,
        };
      });
    };

    const drawRoute = (projected: ProjectedNode[], time: number) => {
      context.save();
      context.lineJoin = "round";
      context.lineCap = "round";

      const completedGradient = context.createLinearGradient(0, 0, width, height);
      completedGradient.addColorStop(0, "rgba(19, 88, 219, 0.12)");
      completedGradient.addColorStop(0.55, "rgba(38, 176, 221, 0.58)");
      completedGradient.addColorStop(1, "rgba(7, 155, 145, 0.8)");

      context.beginPath();
      projected.slice(0, 73).forEach((node, index) => {
        if (index === 0) context.moveTo(node.px, node.py);
        else context.lineTo(node.px, node.py);
      });
      context.strokeStyle = completedGradient;
      context.lineWidth = 1.4;
      context.shadowColor = "rgba(43, 208, 221, 0.45)";
      context.shadowBlur = 8;
      context.stroke();

      context.shadowBlur = 0;
      context.beginPath();
      projected.slice(72).forEach((node, index) => {
        if (index === 0) context.moveTo(node.px, node.py);
        else context.lineTo(node.px, node.py);
      });
      context.setLineDash([4, 9]);
      context.lineDashOffset = -time * 0.018;
      context.strokeStyle = "rgba(218, 234, 240, 0.17)";
      context.lineWidth = 1;
      context.stroke();
      context.restore();
    };

    const drawConnections = (projected: ProjectedNode[]) => {
      const threshold = Math.min(138, width * 0.12);
      context.save();

      for (let first = 0; first < projected.length; first += 1) {
        const nodeA = projected[first];

        for (let second = first + 1; second < projected.length; second += 1) {
          const nodeB = projected[second];
          const deltaX = nodeA.px - nodeB.px;
          const deltaY = nodeA.py - nodeB.py;
          const distance = Math.hypot(deltaX, deltaY);

          if (distance > threshold) continue;

          const completed = nodeA.index < 73 && nodeB.index < 73;
          const alpha = (1 - distance / threshold) * (completed ? 0.16 : 0.055);
          context.beginPath();
          context.moveTo(nodeA.px, nodeA.py);
          context.lineTo(nodeB.px, nodeB.py);
          context.strokeStyle = completed
            ? `rgba(80, 194, 213, ${alpha})`
            : `rgba(218, 234, 240, ${alpha})`;
          context.lineWidth = 0.65;
          context.stroke();
        }
      }

      context.restore();
    };

    const drawNodes = (projected: ProjectedNode[], time: number) => {
      projected.forEach((node) => {
        const number = node.index + 1;
        const completed = number <= 73;
        const current = number === 73;
        const milestone = number % 10 === 0;
        const pulse = 0.72 + Math.sin(time * 0.0023 + node.phase) * 0.28;
        const radius = node.radius * node.scale * (current ? 1 + pulse * 0.22 : 1);

        context.save();
        context.globalAlpha = current ? 1 : completed ? 0.55 + pulse * 0.28 : 0.18 + pulse * 0.1;

        if (current) {
          const halo = context.createRadialGradient(node.px, node.py, 0, node.px, node.py, 34 + pulse * 9);
          halo.addColorStop(0, "rgba(255, 67, 73, 0.48)");
          halo.addColorStop(0.25, "rgba(237, 28, 36, 0.2)");
          halo.addColorStop(1, "rgba(237, 28, 36, 0)");
          context.fillStyle = halo;
          context.beginPath();
          context.arc(node.px, node.py, 42, 0, Math.PI * 2);
          context.fill();

          context.strokeStyle = `rgba(255, 91, 96, ${0.35 + pulse * 0.4})`;
          context.lineWidth = 1;
          context.beginPath();
          context.arc(node.px, node.py, 12 + pulse * 7, 0, Math.PI * 2);
          context.stroke();
        }

        context.beginPath();
        context.arc(node.px, node.py, Math.max(0.8, radius), 0, Math.PI * 2);
        context.fillStyle = current
          ? "#ff343b"
          : milestone
            ? "#f5b51b"
            : completed
              ? number % 3 === 0
                ? "#37d6c8"
                : "#69b8ff"
              : "#d9eaf0";
        context.shadowColor = current ? "#ff343b" : completed ? "#4ac8de" : "transparent";
        context.shadowBlur = current ? 18 : completed ? 5 : 0;
        context.fill();

        if (current && width > 900) {
          context.shadowBlur = 0;
          context.globalAlpha = 0.92;
          context.fillStyle = "rgba(239, 248, 251, 0.94)";
          context.font = "800 11px ui-monospace, SFMono-Regular, Menlo, monospace";
          context.letterSpacing = "0.12em";
          context.fillText("#073 / CURRENT", node.px + 21, node.py - 18);
        }

        context.restore();
      });
    };

    const drawStreaks = (time: number) => {
      context.save();
      context.globalCompositeOperation = "screen";

      for (let index = 0; index < 3; index += 1) {
        const progress = (time * (0.000045 + index * 0.000007) + index * 0.31) % 1;
        const x = -180 + progress * (width + 360);
        const y = height * (0.2 + index * 0.24) + Math.sin(progress * Math.PI * 2) * 36;
        const gradient = context.createLinearGradient(x - 150, y + 50, x, y);
        gradient.addColorStop(0, "rgba(82, 173, 255, 0)");
        gradient.addColorStop(1, index === 1 ? "rgba(255, 69, 75, 0.3)" : "rgba(82, 173, 255, 0.34)");
        context.beginPath();
        context.moveTo(x - 150, y + 50);
        context.lineTo(x, y);
        context.strokeStyle = gradient;
        context.lineWidth = 1;
        context.stroke();
      }

      context.restore();
    };

    const draw = (time: number) => {
      if (!width || !height) return;

      context.clearRect(0, 0, width, height);
      const elapsed = time - startTime;
      const reveal = reducedMotion.matches ? 1 : 1 - Math.pow(2, -10 * Math.min(1, elapsed / 1700));
      const projected = projectNodes(time, reveal);

      drawStreaks(time);
      drawConnections(projected);
      drawRoute(projected, time);
      drawNodes(projected, time);
    };

    const animate = (time: number) => {
      draw(time);
      if (!reducedMotion.matches && sceneVisible && !document.hidden) {
        animationFrame = window.requestAnimationFrame(animate);
      }
    };

    const start = () => {
      window.cancelAnimationFrame(animationFrame);
      startTime = performance.now();
      if (reducedMotion.matches) draw(startTime + 1700);
      else animationFrame = window.requestAnimationFrame(animate);
    };

    const handlePointerMove = (event: PointerEvent) => {
      const bounds = hero.getBoundingClientRect();
      pointerTargetX = (event.clientX - bounds.left) / bounds.width - 0.5;
      pointerTargetY = (event.clientY - bounds.top) / bounds.height - 0.5;
    };

    const handlePointerLeave = () => {
      pointerTargetX = 0;
      pointerTargetY = 0;
    };

    const handleVisibility = () => {
      if (!document.hidden && sceneVisible) start();
    };

    const resizeObserver = new ResizeObserver(resize);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      sceneVisible = entry.isIntersecting;
      if (sceneVisible) start();
      else window.cancelAnimationFrame(animationFrame);
    });

    resizeObserver.observe(hero);
    intersectionObserver.observe(hero);
    hero.addEventListener("pointermove", handlePointerMove, { passive: true });
    hero.addEventListener("pointerleave", handlePointerLeave);
    document.addEventListener("visibilitychange", handleVisibility);
    reducedMotion.addEventListener("change", start);
    resize();
    start();

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        hero.removeEventListener("pointermove", handlePointerMove);
        hero.removeEventListener("pointerleave", handlePointerLeave);
        document.removeEventListener("visibilitychange", handleVisibility);
        reducedMotion.removeEventListener("change", start);
      },
      { once: true },
    );
  };

  const initializeBackdrops = () => {
    document
      .querySelectorAll<HTMLElement>("[data-cinematic-backdrop]")
      .forEach(initializeBackdrop);
  };

  initializeBackdrops();
  document.addEventListener("astro:page-load", initializeBackdrops);
</script>
