---
import type { MonthStat } from "../../lib/insights";

interface Props {
  months: MonthStat[];
}

const { months } = Astro.props;
const peak = Math.max(...months.map((month) => month.count), 1);
---

<ol class="pulse">
  {
    months.map((month) => (
      <li class:list={{ peak: month.count === peak }}>
        <span class="count">{month.count}</span>
        <span class="track">
          <span
            class="bar"
            style={`--ratio:${month.count / peak}`}
            role="img"
            aria-label={`${month.name}: ${month.count} hackathons`}
          />
        </span>
        <span class="initial">{month.initial}</span>
      </li>
    ))
  }
</ol>

<style>
  .pulse {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-rows: auto 132px auto;
    gap: 7px;
    justify-items: center;
  }

  .count {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  li.peak .count {
    color: var(--red);
  }

  .track {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: flex-end;
    border-bottom: 2px solid var(--line-strong);
  }

  .bar {
    display: block;
    width: 100%;
    height: calc(var(--ratio) * 100%);
    min-height: 2px;
    background: rgba(14, 18, 18, 0.24);
    transform-origin: bottom;
    animation: rise 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  li.peak .bar {
    background: var(--red);
  }

  .initial {
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  @keyframes rise {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  @media (max-width: 620px) {
    .pulse {
      gap: 4px;
    }

    li {
      grid-template-rows: auto 92px auto;
    }

    .count {
      font-size: 0.62rem;
    }

    .initial {
      font-size: 0.62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      animation: none;
    }
  }
</style>
