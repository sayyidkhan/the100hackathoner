---
import type { Hackathon } from "../../lib/hackathons";
import { buildAwards } from "../../lib/insights";

interface Props { items: Hackathon[]; awardedOnly?: boolean; }
const { items, awardedOnly = true } = Astro.props;
const awardEntries = buildAwards(items);
const builds = items.filter((item) => !awardedOnly || item.award?.trim()).sort((a, b) => a.number - b.number);
const sizes = [...new Set(items.map((item) => item.members.length))].sort((a, b) => a - b);
const groups = sizes.map((size) => ({
  size,
  label: size === 0 ? "Team not recorded" : size === 1 ? "Solo" : `${size}-person teams`,
  builds: builds.filter((item) => item.members.length === size),
}));
// A shared scale and the same size rows make the two charts comparable.
const peak = Math.max(...sizes.map((size) => items.filter((item) => item.members.length === size).length), 1);
---

<div class:list={["winning-teams", { awarded: awardedOnly }]}>
  <h3>{awardedOnly ? "Winning team composition" : "Team composition"}</h3>
  <p class="hint">{builds.length} {awardedOnly ? "awarded builds" : "hackathons"} · Select a size to see the lineups.</p>
  <ol class="composition" aria-label={awardedOnly ? "Awarded builds by team size" : "All builds by team size"}>
    {groups.map((group) => (
      <li>
        {group.builds.length ? <details>
          <summary class="size-row">
            <span class="size-label">{group.label}</span>
            <span class="track" aria-hidden="true"><span style={`--ratio:${group.builds.length / peak}`} /></span>
            <span class="count">{group.builds.length}</span>
            <span class="expand" aria-hidden="true">+</span>
          </summary>
          <div class="lineups">
            <p>{group.builds.length} {awardedOnly ? "awarded build" : "hackathon"}{group.builds.length === 1 ? "" : "s"}</p>
            <ol>
              {group.builds.map((item) => (
                <li>
                  <a href={`/hackathons/${item.number}/`}>
                    <span class="record-number">#{String(item.number).padStart(3, "0")}</span>
                    <strong>{item.title}</strong>
                    <span aria-hidden="true">↗</span>
                  </a>
                  {item.award && <p class="result"><b>{awardEntries.find((entry) => entry.number === item.number)?.win ? "Win" : "Awarded"}</b> · {item.award}</p>}
                  <ul aria-label={`Team for ${item.title}`}>
                    {item.members.map((member) => <li>{member}</li>)}
                  </ul>
                  {!item.members.length && <p class="missing">Member names not recorded.</p>}
                </li>
              ))}
            </ol>
          </div>
        </details> : <div class="size-row empty">
          <span class="size-label">{group.label}</span>
          <span class="track" aria-hidden="true" />
          <span class="count">0</span>
          <span />
        </div>}
      </li>
    ))}
  </ol>
</div>

<style>
  .winning-teams { --composition-accent: var(--teal); min-width: 0; }
  .winning-teams.awarded { --composition-accent: var(--gold); }
  h3 { margin: 0 0 8px; font-size: 19px; font-weight: 500; letter-spacing: -.025em; }
  .hint { margin: 0 0 20px; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .composition, .lineups ol, .lineups ul { list-style: none; margin: 0; padding: 0; }
  .composition { display: grid; gap: 8px; }
  .size-row { display: grid; grid-template-columns: minmax(0, 120px) minmax(0, 1fr) 26px 18px; gap: 10px; align-items: center; min-height: 48px; padding: 8px 0; list-style: none; }
  summary { cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--composition-accent); outline-offset: 3px; border-radius: 4px; }
  .size-label { font-size: 14px; color: var(--ink); }
  .track { height: 18px; background: var(--soft); border-radius: 2px; }
  .track > span { display: block; height: 100%; width: calc(var(--ratio) * 100%); background: var(--composition-accent); border-radius: 2px; }
  .count { color: var(--muted); font: 14px var(--mono); text-align: right; }
  .expand { color: var(--composition-accent); font: 20px var(--mono); text-align: center; }
  details[open] .expand { transform: rotate(45deg); }
  .lineups { margin: 8px 0 16px; padding: 18px; border: 1px solid var(--line); border-left: 3px solid var(--composition-accent); border-radius: 8px; background: var(--raised); }
  .lineups > p { margin: 0 0 16px; color: var(--muted); font: 11px/1.5 var(--mono); }
  .lineups > ol { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .lineups > ol > li { min-width: 0; }
  .lineups a { display: flex; gap: 10px; align-items: baseline; min-height: 44px; color: var(--ink); text-decoration: none; }
  .lineups a strong { font-size: 14px; line-height: 1.5; font-weight: 500; overflow-wrap: anywhere; }
  .record-number { flex-shrink: 0; color: var(--award); font: 11px var(--mono); }
  .lineups a > span:last-child { margin-left: auto; color: var(--award); }
  .lineups a:hover strong { text-decoration: underline; text-underline-offset: 3px; }
  .lineups a:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .result { margin: 4px 0 12px; font-size: 12px; line-height: 1.6; color: var(--muted); }
  .result b { color: var(--award); font-weight: 500; }
  .lineups ul { display: flex; flex-wrap: wrap; gap: 6px; }
  .lineups ul li { padding: 5px 8px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: var(--surface); font-size: 11px; overflow-wrap: anywhere; }
  .missing { color: var(--faint); font-size: 12px; }
  @media (max-width: 620px) {
    .size-row { grid-template-columns: minmax(0, 1fr) 30px 20px; gap: 6px 10px; }
    .track { grid-column: 1 / -1; grid-row: 2; height: 14px; }
    .lineups { padding: 14px; }
    .lineups > ol { grid-template-columns: 1fr; }
  }
</style>
