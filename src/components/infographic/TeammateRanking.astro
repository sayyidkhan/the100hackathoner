---
import type { CollaborationStat } from "../../lib/insights";

interface Props {
  items: CollaborationStat[];
  accent?: "teal" | "gold";
  repeatLabel: string;
  singleLabel: string;
}

const {
  items,
  accent = "teal",
  repeatLabel,
  singleLabel,
} = Astro.props;
const repeated = items.filter((person) => person.count > 1);
const single = items.filter((person) => person.count === 1);
const peak = Math.max(...repeated.map((person) => person.count), 1);
---

<div class:list={["teammate-ranking", accent]}>
  {
    repeated.length > 0 && (
      <>
        <p class="section-label">{repeatLabel}</p>
        <ol class="bar-list">
          {
            repeated.map((person) => (
              <li class="teammate">
                <details class="teammate-details">
                <summary class="teammate-row">
                <span class="name">{person.label}</span>
                <span class="track" aria-hidden="true">
                  <span class="bar" style={`--ratio:${person.count / peak}`} />
                </span>
                <b class="count">{person.count}</b>
                <span class="expand-mark" aria-hidden="true">+</span>
                </summary>
                <div class="breakdown">
                  <p>{person.count} hackathons together</p>
                  <ol aria-label={`Hackathons with ${person.label}`}>
                    {person.hackathons.map((hackathon) => (
                      <li>
                        <a href={`/hackathons/${hackathon.number}/`}>
                          <b>#{String(hackathon.number).padStart(3, "0")}</b>
                          <span>{hackathon.title}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
                </details>
              </li>
            ))
          }
        </ol>
      </>
    )
  }

  {
    single.length > 0 && (
      <div class="single-roster">
        <p class="section-label">{singleLabel} · {single.length} teammates</p>
        <ol>
          {
            single.map((person) => (
              <li class="teammate">
                <details class="teammate-details">
                <summary class="teammate-row">
                <span class="dot" aria-hidden="true" />
                <span class="name">{person.label}</span>
                <span class="expand-mark" aria-hidden="true">+</span>
                </summary>
                <div class="breakdown">
                  <p>1 hackathon together</p>
                  <ol aria-label={`Hackathons with ${person.label}`}>
                    {person.hackathons.map((hackathon) => (
                      <li>
                        <a href={`/hackathons/${hackathon.number}/`}>
                          <b>#{String(hackathon.number).padStart(3, "0")}</b>
                          <span>{hackathon.title}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
                </details>
              </li>
            ))
          }
        </ol>
      </div>
    )
  }
</div>

<style>
  .teammate-ranking { --crew-accent: var(--teal); }
  .teammate-ranking.gold { --crew-accent: var(--gold); }
  .section-label { margin: 0 0 14px; color: var(--faint); font-size: .7rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .bar-list, .single-roster ol, .breakdown ol { margin: 0; padding: 0; list-style: none; }
  .bar-list { display: grid; gap: 4px; }
  .teammate { min-width: 0; }
  .teammate-row { display: grid; grid-template-columns: minmax(0, 150px) minmax(0, 1fr) 34px 20px; gap: 14px; align-items: center; min-height: 44px; padding: 8px 0; cursor: pointer; list-style: none; }
  .teammate-row::-webkit-details-marker { display: none; }
  .name { color: var(--ink); font-size: .82rem; font-weight: 500; letter-spacing: -.01em; overflow-wrap: anywhere; }
  .teammate-row:hover .name, details[open] > .teammate-row .name { color: var(--crew-accent); }
  .teammate-row:focus-visible { outline: 2px solid var(--crew-accent); outline-offset: 3px; border-radius: 4px; }
  .track { display: block; height: 18px; border-radius: 2px; background: var(--soft); }
  .bar { display: block; width: calc(var(--ratio) * 100%); min-width: 3px; height: 100%; border-radius: 2px; background: var(--crew-accent); }
  .count { color: var(--muted); font-size: .8rem; font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; }
  .expand-mark { color: var(--crew-accent); text-align: center; font: 20px/1 var(--mono); transition: transform 160ms ease; }
  details[open] > .teammate-row .expand-mark { transform: rotate(45deg); }
  .breakdown { margin: 8px 0 16px; padding: 16px 20px; border: 1px solid var(--line); border-left: 3px solid var(--crew-accent); border-radius: 8px; background: var(--raised); }
  .breakdown > p { margin: 0 0 12px; color: var(--muted); font: 11px/1.5 var(--mono); }
  .breakdown ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .breakdown li { min-width: 0; }
  .breakdown a { display: flex; gap: 10px; align-items: baseline; min-height: 44px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 13px; line-height: 1.5; text-decoration: none; }
  .breakdown a b { flex-shrink: 0; color: var(--crew-accent); font: 12px/1.5 var(--mono); }
  .breakdown a span { min-width: 0; overflow-wrap: anywhere; }
  .breakdown a::after { content: "↗"; margin-left: auto; color: var(--crew-accent); }
  .breakdown a:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .breakdown a:focus-visible { outline: 2px solid var(--crew-accent); outline-offset: 2px; }
  .single-roster { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); }
  .single-roster > ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; align-items: start; }
  .single-roster .teammate { border: 1px solid var(--line); border-radius: 8px; background: var(--raised); }
  .single-roster .teammate-row { grid-template-columns: 7px minmax(0, 1fr) 20px; gap: 8px; padding: 10px 12px; }
  .single-roster .name { font-size: .74rem; }
  .single-roster .breakdown { margin: 0; padding: 12px; border: 0; border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; }
  .single-roster .breakdown ol { grid-template-columns: 1fr; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--crew-accent); }
  @media (max-width: 620px) {
    .teammate-row { grid-template-columns: minmax(0, 1fr) 30px 20px; gap: 6px 10px; }
    .bar-list .track { grid-column: 1 / -1; grid-row: 2; height: 14px; }
    .breakdown { padding: 12px 14px; }
    .breakdown ol { grid-template-columns: 1fr; }
    .single-roster > ol { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .expand-mark { transition: none; } }
</style>
