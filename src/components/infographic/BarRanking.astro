---
import type { Ranked } from "../../lib/insights";

interface Props {
  items: Array<Ranked & { hackathons?: Array<{ number: number; title: string }> }>;
  accent?: "ink" | "blue" | "teal" | "gold";
  labelWidth?: string;
}

const { items, accent = "ink", labelWidth = "minmax(0, 148px)" } = Astro.props;
const peak = Math.max(...items.map((item) => item.count), 1);
---

<ol class:list={["ranking", accent]} style={`--label-w:${labelWidth}`}>
  {
    items.map((item) => (
      <li>
        {item.hackathons?.length ? (
          <details>
            <summary class="ranking-row">
              <span class="label">{item.label}</span>
              <span class="track" aria-hidden="true">
                <span class="bar" style={`--ratio:${item.count / peak}`} />
              </span>
              <span class="count">{item.count}</span>
              <span class="expand-mark" aria-hidden="true">+</span>
            </summary>
            <div class="breakdown">
              <p>{item.count} hackathon{item.count === 1 ? "" : "s"}</p>
              <ol aria-label={`Hackathons: ${item.label}`}>
                {item.hackathons.map((hackathon) => (
                  <li>
                    <a href={`/hackathons/${hackathon.number}/`}>
                      <b>#{String(hackathon.number).padStart(3, "0")}</b>
                      <span>{hackathon.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </details>
        ) : (
          <div class="ranking-row">
            <span class="label">{item.label}</span>
            <span class="track" aria-hidden="true">
              <span class="bar" style={`--ratio:${item.count / peak}`} />
            </span>
            <span class="count">{item.count}</span>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .ranking { --ranking-accent: var(--ink); display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .ranking.blue { --ranking-accent: var(--blue); }
  .ranking.teal { --ranking-accent: var(--teal); }
  .ranking.gold { --ranking-accent: var(--gold); }
  .ranking > li { min-width: 0; }
  .ranking-row { display: grid; grid-template-columns: var(--label-w) minmax(0, 1fr) 34px 20px; gap: 14px; align-items: center; min-height: 44px; padding: 8px 0; list-style: none; }
  summary.ranking-row { cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary:hover .label, details[open] > summary .label { color: var(--ranking-accent); text-decoration: underline; text-underline-offset: 4px; }
  summary:focus-visible { outline: 2px solid var(--ranking-accent); outline-offset: 3px; border-radius: 4px; }
  .label { color: var(--ink); font-size: .82rem; font-weight: 500; letter-spacing: -.01em; overflow-wrap: anywhere; }
  .track { display: block; height: 18px; border-radius: 2px; background: var(--soft); }
  .bar { display: block; width: calc(var(--ratio) * 100%); min-width: 3px; height: 100%; border-radius: 2px; background: var(--ranking-accent); }
  .count { color: var(--muted); font-size: .8rem; font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; }
  .expand-mark { color: var(--ranking-accent); text-align: center; font: 20px/1 var(--mono); transition: transform 160ms ease; }
  details[open] > summary .expand-mark { transform: rotate(45deg); }
  .breakdown { margin: 8px 0 16px; padding: 16px 20px; border: 1px solid var(--line); border-left: 3px solid var(--ranking-accent); border-radius: 8px; background: var(--raised); }
  .breakdown > p { margin: 0 0 12px; color: var(--muted); font: 11px/1.5 var(--mono); }
  .breakdown ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; margin: 0; padding: 0; list-style: none; }
  .breakdown li { min-width: 0; }
  .breakdown a { display: flex; gap: 10px; align-items: baseline; min-height: 44px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 13px; line-height: 1.5; text-decoration: none; }
  .breakdown a b { flex-shrink: 0; color: var(--ranking-accent); font: 12px/1.5 var(--mono); }
  .breakdown a span { min-width: 0; overflow-wrap: anywhere; }
  .breakdown a::after { content: "↗"; margin-left: auto; color: var(--ranking-accent); }
  .breakdown a:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .breakdown a:focus-visible { outline: 2px solid var(--ranking-accent); outline-offset: 2px; }
  @media (max-width: 620px) {
    .ranking-row { grid-template-columns: minmax(0, 1fr) 30px 20px; gap: 6px 10px; }
    .label { font-size: .78rem; }
    .track { grid-column: 1 / -1; grid-row: 2; height: 14px; }
    .breakdown { padding: 12px 14px; }
    .breakdown ol { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .expand-mark { transition: none; } }
</style>
