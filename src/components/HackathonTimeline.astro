---
import type { Hackathon } from "../lib/hackathons";
import {
  classifyAward,
  formatDateLabel,
  formatDuration,
  formatTeam,
  getYear,
} from "../lib/format";

interface Props {
  items: Hackathon[];
  limit?: number;
  showYears?: boolean;
}

const { items, limit, showYears = true } = Astro.props;
const visibleItems = limit ? items.slice(0, limit) : items;

interface Row {
  item: Hackathon;
  dateLabel: string | null;
  duration: string | null;
  place: string | null;
  tier: ReturnType<typeof classifyAward>;
  team: string;
  tags: string[];
}

interface Group {
  year: number | null;
  rows: Row[];
}

const groups: Group[] = [];

for (const item of visibleItems) {
  const year = getYear(item.startDate, item.dateLabel);
  const row: Row = {
    item,
    dateLabel: formatDateLabel(item.dateLabel, item.startDate),
    duration: formatDuration(item.duration, item.durationUnit),
    place: [item.location, item.country].filter(Boolean).join(", ") || null,
    tier: classifyAward(item.award),
    team: formatTeam(item.members),
    tags: item.tags.slice(0, 2),
  };

  const current = groups.at(-1);
  if (current && current.year === year) {
    current.rows.push(row);
  } else {
    groups.push({ year, rows: [row] });
  }
}

function gapBefore(index: number) {
  if (index === 0) return null;

  const previous = groups[index - 1].year;
  const current = groups[index].year;
  if (!previous || !current) return null;

  const missing = previous - current - 1;
  if (missing < 1) return null;

  return missing === 1
    ? `${current + 1}`
    : `${current + 1} – ${previous - 1}`;
}
---

<div class="timeline">
  {
    groups.map((group, groupIndex) => {
      const gap = gapBefore(groupIndex);
      const wins = group.rows.filter((row) => row.tier !== "shipped").length;

      return (
        <section class="year-group">
          {gap && (
            <p class="gap" aria-hidden="true">
              <span>{gap}</span>
              <span class="gap-note">no hackathons logged</span>
            </p>
          )}

          {showYears && (
            <header class="year-head">
              <h2>{group.year ?? "Undated"}</h2>
              <p>
                {group.rows.length}{" "}
                {group.rows.length === 1 ? "build" : "builds"}
                {wins > 0 && <span class="year-wins">{wins} awarded</span>}
              </p>
            </header>
          )}

          <ol class="rows">
            {group.rows.map((row) => (
              <li>
                <a class="row" href={`/hackathons/${row.item.number}/`}>
                  <span class="spine" aria-hidden="true" />

                  <div class="stamp">
                    <span class="number">
                      {String(row.item.number).padStart(3, "0")}
                    </span>
                    <time datetime={row.item.startDate ?? undefined}>
                      {row.dateLabel ?? "Date not recorded"}
                    </time>
                    {row.duration && <span class="span">{row.duration}</span>}
                  </div>

                  <div class="body">
                    <p class="event">{row.item.event}</p>
                    <h3>
                      {row.item.title}
                      <span class="arrow" aria-hidden="true">→</span>
                    </h3>
                    <p class="solution">
                      {row.item.solution ?? "Project details not recorded."}
                    </p>

                    <ul class="facts">
                      {row.place && (
                        <li class="place">{row.place}</li>
                      )}
                      {row.tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                      <li class="team">{row.team}</li>
                    </ul>
                  </div>

                  <div class:list={["outcome", row.tier]}>
                    {row.item.award ? (
                      <>
                        <span class="outcome-tag">
                          {row.tier === "podium" ? "★ Award" : "Award"}
                        </span>
                        <span class="outcome-text">{row.item.award}</span>
                      </>
                    ) : (
                      <span class="outcome-tag">Shipped</span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }
</div>

<style>
  .timeline {
    --stamp: 168px;
    --gutter: 34px;
  }

  .year-group + .year-group {
    margin-top: 18px;
  }

  /* Year marker ------------------------------------------------------- */

  .year-head {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-items: baseline;
    padding: 14px 0 10px;
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg);
    box-shadow: 0 12px 14px -12px rgba(14, 18, 18, 0.22);
  }

  .year-head h2 {
    width: var(--stamp);
    margin: 0;
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 950;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .year-head p {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin: 0;
    color: var(--faint);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .year-wins {
    padding-left: 14px;
    border-left: 1px solid var(--line);
    color: var(--gold-ink);
  }

  .gap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
    margin: 0;
    padding: 20px 0;
    border-top: 1px dashed var(--line);
    color: var(--faint);
  }

  .gap span:first-child {
    width: var(--stamp);
    font-size: 0.92rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .gap-note {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Rows -------------------------------------------------------------- */

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--stamp) minmax(0, 1fr) 186px;
    gap: var(--gutter);
    align-items: start;
    padding: 26px 20px 26px 0;
    border-bottom: 1px solid var(--line);
    transition:
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .row::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -20px;
    width: 3px;
    background: var(--red);
    content: "";
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .row:hover,
  .row:focus-visible {
    background: var(--bg-paper);
    box-shadow:
      -20px 0 0 var(--bg-paper),
      20px 0 0 var(--bg-paper);
    outline: none;
  }

  .row:hover::before,
  .row:focus-visible::before {
    opacity: 1;
  }

  /* Left stamp: index, date, duration --------------------------------- */

  .stamp {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-left: 24px;
  }

  .spine {
    position: absolute;
    top: -26px;
    bottom: -26px;
    left: 4px;
    width: 1px;
    background: var(--line);
  }

  .stamp::before {
    position: absolute;
    top: 8px;
    left: 0;
    width: 9px;
    height: 9px;
    border: 2px solid var(--faint);
    border-radius: 50%;
    background: var(--bg);
    content: "";
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .row:hover .stamp::before,
  .row:focus-visible .stamp::before {
    border-color: var(--red);
    background: var(--red);
    transform: scale(1.25);
  }

  .number {
    color: var(--ink);
    font-size: 1.42rem;
    font-weight: 950;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
    line-height: 0.85;
    transition: color 180ms ease;
  }

  .number::before {
    color: var(--faint);
    content: "#";
    font-size: 0.78em;
  }

  .row:hover .number,
  .row:focus-visible .number {
    color: var(--red);
  }

  time {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }

  .span {
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Middle body ------------------------------------------------------- */

  .event {
    margin: 0;
    color: var(--red);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  h3 {
    margin: 6px 0 8px;
    color: var(--ink);
    font-size: clamp(1.4rem, 2.4vw, 2.05rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .arrow {
    display: inline-block;
    margin-left: 10px;
    color: var(--red);
    font-size: 0.62em;
    font-weight: 800;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
    vertical-align: middle;
  }

  .row:hover .arrow,
  .row:focus-visible .arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .solution {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.62;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--muted);
    font-size: 0.71rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .facts .tag {
    border-color: rgba(19, 88, 219, 0.28);
    background: rgba(19, 88, 219, 0.06);
    color: #10399b;
    text-transform: capitalize;
  }

  .facts .place {
    max-width: 30ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .facts .team {
    border-style: dashed;
    color: var(--faint);
  }

  /* Right outcome ----------------------------------------------------- */

  .outcome {
    display: flex;
    flex-direction: column;
    gap: 7px;
    align-items: flex-end;
    text-align: right;
  }

  .outcome-tag {
    padding: 5px 9px;
    border-radius: 3px;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .outcome.shipped .outcome-tag {
    border: 1px solid var(--line);
    color: var(--faint);
  }

  .outcome.recognised .outcome-tag {
    background: rgba(7, 155, 145, 0.13);
    color: #06635d;
  }

  .outcome.podium .outcome-tag {
    background: var(--gold);
    color: var(--gold-ink);
  }

  .outcome-text {
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  /* Responsive -------------------------------------------------------- */

  @media (max-width: 940px) {
    .timeline {
      --stamp: 138px;
      --gutter: 22px;
    }

    .year-head {
      position: static;
      backdrop-filter: none;
    }

    .row {
      grid-template-columns: var(--stamp) minmax(0, 1fr);
      padding-right: 0;
    }

    .outcome {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-top: 14px;
      text-align: left;
    }

    .outcome-text {
      font-size: 0.76rem;
    }
  }

  @media (max-width: 620px) {
    .year-head h2,
    .gap span:first-child {
      width: auto;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .stamp {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      padding-left: 0;
    }

    .spine,
    .stamp::before {
      display: none;
    }

    .outcome {
      grid-column: 1;
      margin-top: 4px;
    }

    .facts .place {
      max-width: 24ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .arrow,
    .number,
    .stamp::before {
      transition: none;
    }
  }
</style>
