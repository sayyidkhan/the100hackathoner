<!-- Native document transitions keep each project's scripts and 3D lifecycle intact. -->
<script is:inline>
  (() => {
    const root = document.documentElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const storageKey = 'project-navigation-transition';
    const nativeTransitions = 'onpageswap' in window && 'onpagereveal' in window;

    function projectNumber(href) {
      if (!href) return null;
      const url = new URL(href, location.href);
      if (url.origin !== location.origin) return null;
      const match = url.pathname.match(/^\/hackathons\/(\d+)\/?$/);
      return match ? Number(match[1]) : null;
    }

    function direction(from, to) {
      const start = projectNumber(from);
      const end = projectNumber(to);
      if (start === null || end === null || start === end) return null;
      return end > start ? 'next' : 'previous';
    }

    function prepare(transition, from, to) {
      if (!transition) return;
      const move = direction(from, to);
      if (reduced.matches || !move) {
        transition.skipTransition();
        return;
      }
      root.dataset.projectDirection = move;
      // A rejected ready promise is expected when a navigation is interrupted.
      transition.ready.catch(() => {});
    }

    window.addEventListener('pageswap', (event) => {
      prepare(event.viewTransition, location.href, event.activation?.entry.url);
    });
    window.addEventListener('pagereveal', (event) => {
      prepare(event.viewTransition, window.navigation?.activation?.from?.url, location.href);
    });

    // Older browsers retain normal links and receive a gentle entrance only.
    if (!nativeTransitions) {
      try {
        const pending = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
        sessionStorage.removeItem(storageKey);
        if (pending?.to === location.href && Date.now() - pending.at < 10000 && !reduced.matches) {
          const move = direction(pending.from, pending.to);
          if (move) {
            root.dataset.projectDirection = move;
            root.classList.add('project-entering');
          }
        }
      } catch { /* Storage is optional; navigation must always work. */ }
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('[data-project-link]') : null;
        if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || reduced.matches) return;
        try {
          sessionStorage.setItem(storageKey, JSON.stringify({ from: location.href, to: link.href, at: Date.now() }));
        } catch { /* No storage: use an ordinary document navigation. */ }
      });
    }

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) root.classList.remove('project-entering');
    });
    document.addEventListener('animationend', (event) => {
      if (event.animationName === 'project-arrive') root.classList.remove('project-entering');
    });
  })();
</script>

<style is:global>
  @view-transition { navigation: auto; }

  :root { --project-enter-x: 48px; --project-leave-x: -32px; }
  :root[data-project-direction='previous'] { --project-enter-x: -48px; --project-leave-x: 32px; }
  .record { view-transition-name: project-record; }

  /* Keep the page chrome still while the project moves between snapshots. */
  ::view-transition-old(root) { display: none; }
  ::view-transition-new(root) { animation: none; }
  ::view-transition-group(project-record) { animation-duration: 360ms; animation-timing-function: cubic-bezier(.22, 1, .36, 1); }
  ::view-transition-old(project-record),
  ::view-transition-new(project-record) { mix-blend-mode: normal; height: 100%; object-fit: cover; object-position: top; }
  ::view-transition-old(project-record) { animation: project-depart 240ms cubic-bezier(.4, 0, 1, 1) both; }
  ::view-transition-new(project-record) { animation: project-arrive 360ms cubic-bezier(.22, 1, .36, 1) both; }
  .project-entering .record { animation: project-arrive 360ms cubic-bezier(.22, 1, .36, 1) both; }

  @keyframes project-depart {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(var(--project-leave-x)); }
  }
  @keyframes project-arrive {
    from { opacity: 0; transform: translateX(var(--project-enter-x)); }
    to { opacity: 1; transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition { navigation: none; }
    .project-entering .record { animation: none; }
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none; }
  }
</style>
