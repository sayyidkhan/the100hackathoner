---
const nav = [
  ["Journey", "/hackathons/"],
  ["Awards", "/awards/"],
  ["Judging", "/judging/"],
  ["Principles", "/principles/"],
  ["Field Notes", "/essays/"],
  ["About", "/about/"],
];

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="beta-banner" aria-label="Site status">
    <div class="container beta-inner">
      <span>Open beta</span>
      <p>
        This site is still a work in progress. More notes and context are being
        documented over the coming weeks.
      </p>
    </div>
  </div>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="The 100 Hackathoner">
      <span>100</span>
      <strong>The 100 Hackathoner</strong>
    </a>
    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
      {
        nav.map(([label, href]) => (
          <a href={href} class={pathname === href ? "active" : ""}>
            {label}
          </a>
        ))
      }
    </nav>
    <a class="invite" href="/about/#contact">Invite Me</a>
    <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
      Menu <span aria-hidden="true">☰</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: rgba(247, 245, 239, 0.98);
  }

  .beta-banner {
    border-bottom: 1px solid rgba(14, 18, 18, 0.1);
    background: var(--yellow);
    color: var(--black);
  }

  .beta-inner {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding-block: 7px;
    text-align: center;
  }

  .beta-inner span {
    flex: 0 0 auto;
    padding: 3px 7px;
    border: 1px solid var(--black);
    border-radius: 3px;
    background: var(--black);
    color: white;
    font-size: 0.68rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .beta-inner p {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    min-width: 0;
  }

  .brand span {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 2px solid var(--red);
    border-radius: 3px;
    color: var(--red);
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
  }

  .brand strong {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .primary-nav {
    display: flex;
    flex-wrap: nowrap;
    gap: 17px;
    justify-content: center;
  }

  .primary-nav a,
  .invite {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .primary-nav a {
    position: relative;
    white-space: nowrap;
  }

  .primary-nav a::after {
    position: absolute;
    right: 0;
    bottom: 1px;
    left: 0;
    height: 2px;
    content: "";
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
  }

  .primary-nav a:hover::after,
  .primary-nav a.active::after {
    transform: scaleX(1);
  }

  .invite {
    justify-content: center;
    min-width: 92px;
    padding: 0 13px;
    border: 1px solid var(--black);
    border-radius: 4px;
    background: var(--black);
    color: white;
  }

  .menu-toggle { display: none; }

  @media (max-width: 1100px) {
    .beta-inner {
      justify-content: flex-start;
      text-align: left;
    }

    .header-inner {
      position: relative;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 12px;
      padding: 12px 0;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 40px;
      padding: 0 12px;
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      font: inherit;
      font-size: .8rem;
      font-weight: 850;
    }

    .menu-toggle:hover, .menu-toggle:focus-visible {
      border-color: var(--red);
      color: var(--red);
    }

    .menu-toggle span { font-size: 1rem; line-height: 1; }

    .primary-nav {
      position: absolute;
      top: 100%;
      right: 0;
      display: none;
      width: min(340px, calc(100vw - 32px));
      max-height: 70vh;
      overflow-y: auto;
      gap: 0;
      justify-content: stretch;
      padding: 10px;
      border: 1px solid var(--line-strong);
      background: var(--bg-paper);
      box-shadow: var(--shadow);
    }

    .primary-nav.is-open { display: grid; }

    .primary-nav a {
      width: 100%;
      min-height: 42px;
      padding: 8px 12px;
      font-size: .9rem;
    }

    .primary-nav a:hover, .primary-nav a.active {
      background: color-mix(in srgb, var(--red) 7%, var(--bg-paper));
    }

    .primary-nav a::after { display: none; }
  }

  @media (max-width: 600px) {
    .invite { display: none; }
    .header-inner { grid-template-columns: minmax(0, 1fr) auto; }
  }

  @media (max-width: 480px) {
    .beta-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .beta-inner p {
      font-size: 0.76rem;
    }

    .brand strong {
      max-width: 180px;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const primaryNav = document.querySelector<HTMLElement>("#primary-nav");
  const closeMenu = () => {
    primaryNav?.classList.remove("is-open");
    menuToggle?.setAttribute("aria-expanded", "false");
  };

  menuToggle?.addEventListener("click", () => {
    const isOpen = primaryNav?.classList.toggle("is-open") ?? false;
    menuToggle.setAttribute("aria-expanded", String(isOpen));
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !document.querySelector(".header-inner")?.contains(event.target)) closeMenu();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
  window.matchMedia("(min-width: 1101px)").addEventListener("change", closeMenu);
</script>
