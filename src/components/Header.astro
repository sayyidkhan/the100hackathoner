---
import { mainNavigation } from "../lib/navigation";
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname.startsWith(href);
---
<header class="masthead" id="site-header">
  <a class="site-brand" href="/" aria-label="The 100 Hackathoner home">
    <span class="site-mark">100</span><span>THE 100<br />HACKATHONER</span>
  </a>
  <nav class="desktop-navigation" aria-label="Main navigation">
    {mainNavigation.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
    <a class="site-invite" href="/about/#contact">Invite me <span aria-hidden="true">↗</span></a>
  </nav>
  <button type="button" id="theme-toggle" class="site-theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
    <span id="theme-icon" aria-hidden="true">◐</span>
  </button>
  <a class="site-menu" href="#site-navigation" aria-controls="site-navigation">Menu <span aria-hidden="true">☰</span></a>
    <nav class="mobile-navigation" id="site-navigation" aria-label="Main navigation">
      <a class="menu-close" href="#site-header" aria-label="Close menu">Close menu <span aria-hidden="true">×</span></a>
      {mainNavigation.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}<span aria-hidden="true">↗</span></a>)}
      <a class="site-invite" href="/about/#contact">Invite me <span aria-hidden="true">↗</span></a>
    </nav>
</header>
<script is:inline>
  (() => {
    const toggle = document.querySelector("#theme-toggle");
    const scheme = matchMedia("(prefers-color-scheme: dark)");
    let preference = false;
    try { preference = ["light", "dark"].includes(localStorage.getItem("museum-dark-theme")); } catch {}
    const apply = (theme) => {
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').content = theme === "dark" ? "#100f12" : "#f6f5f0";
      const label = `Switch to ${theme === "dark" ? "light" : "dark"} mode`;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
      toggle.querySelector("span").textContent = theme === "dark" ? "☼" : "◐";
      document.dispatchEvent(new CustomEvent("site:theme-change", { detail: theme }));
    };
    apply(document.documentElement.dataset.theme || "light");
    toggle.addEventListener("click", () => {
      const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      preference = true;
      try { localStorage.setItem("museum-dark-theme", theme); } catch {}
      apply(theme);
    });
    scheme.addEventListener("change", ({ matches }) => { if (!preference) apply(matches ? "dark" : "light"); });
    window.addEventListener("storage", ({ key, newValue }) => {
      if (key !== "museum-dark-theme") return;
      preference = ["light", "dark"].includes(newValue);
      apply(preference ? newValue : scheme.matches ? "dark" : "light");
    });
  })();
</script>
<style>
  .masthead { position: relative; z-index: 30; width: min(1560px, calc(100% - 96px)); height: 92px; margin-inline: auto; display: flex; align-items: center; gap: 20px; border-bottom: 1px solid var(--line); color: var(--ink); font-family: var(--body); }
  .site-brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; font-size: 11px; font-weight: 700; line-height: 1.3; letter-spacing: .05em; text-decoration: none; }
  .site-mark { width: 45px; height: 45px; border: 1px solid var(--accent); border-radius: 50%; display: grid; place-items: center; color: var(--accent); font-size: 22px; font-weight: 600; letter-spacing: -2px; }
  .desktop-navigation { display: flex; align-items: center; gap: 20px; margin-left: auto; font-size: 14px; }
  nav a { color: var(--ink); white-space: nowrap; text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { color: var(--accent); }
  nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 7px; text-decoration-thickness: 1px; }
  .site-invite { display: inline-flex; align-items: center; gap: 24px; padding: 12px 18px; border: 1px solid var(--line); border-radius: 99px; }
  .site-theme-toggle { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; font-size: 20px; }
  .site-theme-toggle:hover { border-color: var(--accent); }
  /* Navigation works with HTML links and CSS alone, independently of all scripts. */
  .site-menu, .mobile-navigation { display: none; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  @media (max-width: 1200px) {
    .desktop-navigation { display: none; }
    .site-theme-toggle { margin-left: auto; }
    .site-menu { display: flex; flex-shrink: 0; align-items: center; gap: 9px; min-height: 44px; padding: 10px 16px; border: 1px solid var(--line); border-radius: 99px; color: var(--ink); text-decoration: none; font-size: 13px; }
    .mobile-navigation { position: absolute; top: calc(100% - 1px); right: 0; z-index: 1; gap: 2px; width: min(320px, 100%); max-height: calc(100dvh - 100px); overflow-y: auto; padding: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--raised); box-shadow: 0 15px 35px #0003; font-size: 14px; }
    .mobile-navigation { scroll-margin-top: 110px; }
    .mobile-navigation:target { display: grid; }
    .mobile-navigation a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; padding: 12px; }
    .mobile-navigation a:hover { background: var(--soft); }
    .mobile-navigation a > span { color: var(--muted); }
    .mobile-navigation .site-invite { margin-top: 8px; }
    .mobile-navigation .menu-close { border-bottom: 1px solid var(--line); color: var(--muted); margin-bottom: 6px; }
  }
  @media (max-width: 1100px) { .masthead { width: calc(100% - 56px); } }
  @media (max-width: 650px) {
    .masthead { width: calc(100% - 36px); height: 78px; gap: 10px; }
    .site-brand { font-size: 9px; gap: 8px; }
    .site-mark { width: 37px; height: 37px; font-size: 19px; }
  }
</style>
